{
  "name": "@dnsmalla/graph-kit",
  "version": "1.6.2",
  "description": "TypeScript implementation of the GraphKit canonical graph engine \u2014 code/text \u2192 typed node/edge graph. Schema-compatible with the Swift package.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dnsmalla/graph-kit.git"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "bin": {
    "graph-kit": "./dist/src/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test dist/test/*.test.js",
    "cli": "node dist/src/cli.js",
    "prepublishOnly": "npm run build",
    "bundle": "esbuild src/cli.ts --bundle --platform=node --target=node18 --format=cjs --minify --outfile=../bin/graph-kit.js"
  },
  "dependencies": {
    "typescript": "^5.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "esbuild": "^0.28.2"
  }
}
