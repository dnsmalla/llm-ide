# Own-server sync (design 8.1, deploy/vps/sync-sftp.md): rate limit per client and exact CORS origins.
limit_req_zone $binary_remote_addr zone=llmidesync:1m rate=2r/s;
map $http_origin $llmidesync_origin {
    default "";
    "https://llm-ide.com" $http_origin;
}

server {
    listen 80;
    server_name llm-ide.com www.llm-ide.com;
    root /var/www/llm-ide-web;
    location /.well-known/acme-challenge/ { root /var/www/llm-ide-web; }
    location / { return 301 https://$host$request_uri; }
}

server {
    listen 443 ssl http2;
    server_name llm-ide.com www.llm-ide.com;

    ssl_certificate /etc/letsencrypt/live/llm-ide.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/llm-ide.com/privkey.pem;

    root /var/www/llm-ide-web;
    index index.html;

    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ws://127.0.0.1:* ws://localhost:* ws://[::1]:* wss: https://g.api.mega.co.nz https://*.userstorage.mega.co.nz; base-uri 'none'; form-action 'none'; object-src 'none'; frame-ancestors 'none'" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    client_max_body_size 8m;

    # Closed 2026-11-05: /api/ exposed a full core (every user is an admin, which means code
    # execution) to the internet. Public accounts come from account-service (ADR 0019).
    location = /api { return 404; }
    location /api/ { return 404; }

    # The temporary SSH tunnel/PIN host path was retired with ADR 0019.
    location = /host-api { return 404; }
    location /host-api/ { return 404; }

    # Own-server sync. Random folder names are the capability. GET only allow-listed reads; PUT only new requests
    # and enrollment claims into desktop-created folders. No listing, no path logs, small bodies, rate-limited.
    location ~ "^/sync/(?<sid>[A-Za-z0-9_-]{22})/(?<f>d/[A-Za-z0-9_-]{22}/(?:key\.bin|wrap\.bin|manifest\.bin|s/[0-9a-f]{32}\.bin|out/[A-Za-z0-9_-]{22}\.bin)|e/[A-Za-z0-9_-]{22}/ack\.bin)$" {
        limit_except GET { deny all; }
        alias /srv/llmide-sync/data/$sid/$f;
        default_type application/octet-stream;
        access_log off;
        error_log /var/log/nginx/error.log crit;
        limit_req zone=llmidesync burst=40 nodelay;
        limit_req_status 429;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        add_header Access-Control-Allow-Origin $llmidesync_origin always;
        add_header Vary Origin always;
    }
    location ~ "^/sync/(?<sid>[A-Za-z0-9_-]{22})/(?<f>d/[A-Za-z0-9_-]{22}/in/[0-9]{13}-[A-Za-z0-9_-]{22}\.bin|e/[A-Za-z0-9_-]{22}/[A-Za-z0-9_-]{22}\.bin)$" {
        if ($request_method = OPTIONS) {
            add_header Access-Control-Allow-Origin $llmidesync_origin always;
            add_header Access-Control-Allow-Methods "PUT" always;
            add_header Access-Control-Max-Age 600 always;
            add_header Vary Origin always;
            return 204;
        }
        limit_except PUT { deny all; }
        alias /srv/llmide-sync/data/$sid/$f;
        dav_methods PUT;
        create_full_put_path off;
        dav_access group:rw;
        client_body_temp_path /srv/llmide-sync-tmp;
        client_max_body_size 64k;
        access_log off;
        error_log /var/log/nginx/error.log crit;
        limit_req zone=llmidesync burst=10 nodelay;
        limit_req_status 429;
        add_header Cache-Control "no-store" always;
        add_header Access-Control-Allow-Origin $llmidesync_origin always;
        add_header Vary Origin always;
    }
    location /sync/ { access_log off; return 404; }

    location = /manifest.webmanifest {
        default_type application/manifest+json;
        try_files $uri =404;
    }
    location = /sw.js {
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }
    location / {
        try_files $uri $uri/ /index.html;
    }
}
