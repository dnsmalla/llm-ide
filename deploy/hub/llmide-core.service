[Unit]
Description=LLM-IDE hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=llmide
Group=llmide
WorkingDirectory=/opt/llmide/current/core/root/extension
EnvironmentFile=/etc/llmide/core.env
EnvironmentFile=-/etc/llmide/bootstrap.env
# R-034 #1 defence in depth: the core's JWT/vault secrets arrive as systemd credentials, not as
# EnvironmentFile values, so an agent Bash child running as the same uid cannot read them from
# /proc/<core>/environ. The real fix is the hub authority clamp (only a team owner/admin may execute).
LoadCredential=jwt-secret:/etc/llmide/jwt.secret
LoadCredential=vault-key:/etc/llmide/vault.key
ProtectProc=invisible
ProcSubset=pid
ExecStart=/opt/llmide/current/core/node/node /opt/llmide/current/core/root/extension/server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/llmide /srv/llmide/projects
LimitNOFILE=65536
UMask=0077
CapabilityBoundingSet=
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
