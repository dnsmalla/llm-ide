#!/bin/sh
# LLM-IDE hub deploy helper (Phase 2). Root-owned, installed at /usr/local/sbin/llmide-deploy.
#
# Only ONE argument is accepted: a stage name from the fixed list below. Every path and value comes
# from a root-owned file under /etc/llmide or from stdin; no caller-supplied text is interpolated.
# The sudoers drop-in grants exactly the stage commands, never a wildcard.
set -eu
umask 077

[ "$(id -u)" -eq 0 ] || { echo "llmide-deploy: must run as root" >&2; exit 1; }
[ "$#" -eq 1 ] || { echo "llmide-deploy: exactly one stage is required" >&2; exit 2; }
stage="$1"

die() { echo "llmide-deploy: $stage: $*" >&2; exit 1; }
replace_line() {
  # replace_line FILE KEY VALUE: portable (no sed -i differences), keeps 0600 root ownership.
  f=$1; k=$2; v=$3; t=$(mktemp)
  sed "s|^${k}=.*|${k}=${v}|" "$f" > "$t"
  chown root:root "$t"; chmod 0600 "$t"; mv "$t" "$f"
}
say() { echo "llmide-deploy: $stage: $*" >&2; }

CONF=/etc/llmide/core.env
UNIT=/etc/systemd/system/llmide-core.service
BACKUP_UNIT=/etc/systemd/system/llmide-backup.service
SITE=/etc/nginx/sites-enabled/llm-ide-hub

staging() {
  # Root-owned, fixed path: the SSH user cannot swap files under it.
  STAGING=/var/lib/llmide-deploy/staging
  install -d -m 0700 -o root -g root /var/lib/llmide-deploy "$STAGING"
}

conf() {
  [ -r "$CONF" ] || die "the env file is missing (run env first)"
  # Only non-secret values are sourced for paths/domain. The secrets stay in the service's environment.
  DOMAIN=$(sed -n 's/^LLMIDE_HUB_DOMAIN=//p' "$CONF" | head -1)
  VERSION=$(sed -n 's/^LLMIDE_HUB_VERSION=//p' "$CONF" | head -1)
  [ -n "$DOMAIN" ] || die "LLMIDE_HUB_DOMAIN is missing"
  [ -n "$VERSION" ] || die "LLMIDE_HUB_VERSION is missing"
  case "$DOMAIN" in ''|-*|*.|*[!a-z0-9.-]*) die "the domain is not valid" ;; esac
  case "$DOMAIN" in *.*.*) ;; *.*) ;; *) die "the domain has no dot" ;; esac
  case "$VERSION" in ''|.*|*.|*[!0-9.]*) die "the version is not valid" ;; esac
  case "$VERSION" in *.*.*) ;; *) die "the version is not x.y.z" ;; esac
}

case "$stage" in
  check)
    [ -r "$CONF" ] || { echo "llmide-deploy: check: no env file yet" >&2; }
    systemctl is-active --quiet llmide-core 2>/dev/null && echo "service=active" || echo "service=inactive"
    printf 'version=%s\n' "$(cat /opt/llmide/current/VERSION 2>/dev/null || true)"
    echo "helper=1"
    echo "ok"
    ;;

  upload)
    staging
    IFS= read -r name || exit 2
    case "$name" in
      bundle.tar.gz|bundle.sha256|VERSION|llm-ide-hub.nginx|setup.html) ;;
      *) die "that file is not uploadable" ;;
    esac
    cat > "$STAGING/$name"
    chmod 0600 "$STAGING/$name"; chown root:root "$STAGING/$name"
    say "ok"
    ;;

  base)
    staging
    install -d -m 0700 -o root -g root /etc/llmide
    install -d -m 0755 -o root -g root /etc/systemd/system /etc/logrotate.d
    if ! id llmide >/dev/null 2>&1; then
      useradd --system --home /var/lib/llmide --shell /usr/sbin/nologin llmide
    fi
    install -d -m 0755 -o root -g root /opt/llmide /opt/llmide/releases
    install -d -m 0700 -o llmide -g llmide /var/lib/llmide /var/lib/llmide/backups
    install -d -m 0755 -o root -g root /srv/llmide
    install -d -m 0700 -o llmide -g llmide /srv/llmide/projects
    install -d -m 0755 -o root -g root /var/www/llmide-web
    # The unit and logrotate are embedded in this root-owned helper, never read from user-writable staging.
    cat > "$UNIT" <<'LLMIDE_UNIT'
[Unit]
Description=LLM-IDE hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=llmide
Group=llmide
WorkingDirectory=/opt/llmide/current/core/root/extension
EnvironmentFile=/etc/llmide/core.env
EnvironmentFile=-/etc/llmide/bootstrap.env
ExecStart=/opt/llmide/current/core/node/node /opt/llmide/current/core/root/extension/server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/llmide /srv/llmide/projects
LimitNOFILE=65536
UMask=0077
CapabilityBoundingSet=
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
LLMIDE_UNIT
    chmod 0644 "$UNIT"; chown root:root "$UNIT"
    cat > "$BACKUP_UNIT" <<'LLMIDE_BACKUP'
[Unit]
Description=LLM-IDE hub on-demand backup

[Service]
Type=oneshot
User=llmide
Group=llmide
EnvironmentFile=/etc/llmide/core.env
ExecStart=/opt/llmide/current/core/node/node /opt/llmide/current/core/root/extension/scripts/backup.mjs
LLMIDE_BACKUP
    chmod 0644 "$BACKUP_UNIT"; chown root:root "$BACKUP_UNIT"
    cat > /etc/logrotate.d/llmide <<'LLMIDE_LOG'
/var/lib/llmide/*.log {
  weekly
  rotate 4
  notifempty
  compress
  missingok
  copytruncate
}
LLMIDE_LOG
    chmod 0644 /etc/logrotate.d/llmide; chown root:root /etc/logrotate.d/llmide
    systemctl daemon-reload
    say "ok"
    ;;

  env)
    [ -d /etc/llmide ] || die "base has not run"
    tmp=$(mktemp /etc/llmide/.core.env.XXXXXX)
    cat > "$tmp"
    # Root-side validation: only KEY=value lines, only the template's keys, no loader/option injection.
    while IFS= read -r line || [ -n "$line" ]; do
      key=${line%%=*}
      case "$key" in
        NODE_ENV|PATH|LLMIDE_HOST|LLMIDE_PORT|LLMIDE_HUB|LLMIDE_TLS_TERMINATED|LLMIDE_HUB_DOMAIN|LLMIDE_HUB_VERSION|LLMIDE_DATA_DIR|LLMIDE_DB_PATH|LLMIDE_PROJECTS_ROOT|LLMIDE_BACKUP_DIR|LLMIDE_BACKUP_KEEP|LLMIDE_DISABLE_REGISTRATION|LLMIDE_TRUST_PROXY|LLMIDE_LOG_JSON|LLMIDE_LOG_LEVEL|LLMIDE_MAX_TURNS|LLMIDE_HOST_API_HUB|LLMIDE_HOST_API_WEB_ORIGINS|LLMIDE_HOST_API_FINGERPRINT_FILE|LLMIDE_HUB_PUBLIC_URL|LLMIDE_JWT_SECRET|LLMIDE_VAULT_KEY) ;;
        *) rm -f "$tmp"; die "the env key $key is outside the allowed set" ;;
      esac
    done < "$tmp"
    if grep -Eq '^(NODE_OPTIONS|LD_[A-Z0-9_]*|BASH_ENV|ENV)=' "$tmp"; then
      rm -f "$tmp"; die "the env contains a forbidden loader variable"
    fi
    # POSIX-portable CR check: GNU grep treats '\r' as a literal 'r', so byte-count with tr.
    if [ "$(tr -d '\r' < "$tmp" | wc -c)" -ne "$(wc -c < "$tmp")" ]; then
      rm -f "$tmp"; die "the env contains a carriage return"
    fi
    # Re-deploy must never rotate the JWT/vault keys: keep the existing values and back up the old env.
    if [ -f "$CONF" ]; then
      for key in LLMIDE_JWT_SECRET LLMIDE_VAULT_KEY; do
        old=$(sed -n "s/^${key}=//p" "$CONF" | head -1)
        case "$old" in
          ''|*[!A-Fa-f0-9]*) ;;
          *) replace_line "$tmp" "$key" "$old" ;;
        esac
      done
      cp -p "$CONF" "$CONF.prev"
    fi
    chown root:root "$tmp"; chmod 0600 "$tmp"
    mv "$tmp" "$CONF"
    if systemctl is-active --quiet llmide-core 2>/dev/null; then systemctl restart llmide-core; fi
    say "ok"
    ;;

  bundle)
    staging
    conf
    bundle_version=$VERSION
    if [ -f "$STAGING/VERSION" ]; then
      bundle_version=$(tr -cd '0-9.' < "$STAGING/VERSION" | head -c 40)
      case "$bundle_version" in *.*.*) ;; *) die "the staged VERSION is not x.y.z" ;; esac
      rm -f "$STAGING/VERSION"
    fi
    [ -f "$STAGING/bundle.tar.gz" ] || die "bundle.tar.gz is missing"
    [ -f "$STAGING/bundle.sha256" ] || die "bundle.sha256 is missing"
    ( cd "$STAGING" && sha256sum -c bundle.sha256 --status ) || die "the bundle checksum does not match"
    work="/opt/llmide/releases/$bundle_version.tmp"
    rm -rf "$work"
    install -d -m 0755 -o root -g root "$work"
    tar -xzf "$STAGING/bundle.tar.gz" -C "$work" --no-same-owner --no-same-permissions
    # --no-same-permissions applies this root shell's umask 077, which strips the group/other
    # execute bit from the staged node. Normalize before running it as the unprivileged user.
    chmod -R u=rwX,go=rX "$work"
    [ -x "$work/core/node/node" ] || die "the bundle has no node binary"
    node_version=$(runuser -u llmide -- "$work/core/node/node" --version 2>/dev/null || true)
    case "$node_version" in v22.*) ;; *) die "the bundled node is not 22 ($node_version)" ;; esac
    release="/opt/llmide/releases/$bundle_version"
    current_real=$(readlink /opt/llmide/current 2>/dev/null || true)
    if [ "$current_real" = "$release" ]; then
      die "refusing to replace the running release $bundle_version (same version)"
    fi
    # Replace a same-version directory only when it is not the running one.
    rm -rf "$release"
    mv "$work" "$release"
    printf '%s\n' "$bundle_version" > "$release/VERSION"
    chmod 0644 "$release/VERSION"; chown root:root "$release/VERSION"
    if [ -L /opt/llmide/current ]; then
      old=$(readlink /opt/llmide/current || true)
      case "$old" in
        /opt/llmide/releases/*) ln -sfn "$old" /opt/llmide/previous ;;
      esac
    fi
    ln -sfn "$release" /opt/llmide/current
    printf 'LLMIDE_BUNDLE_SWITCHED=%s\n' "$bundle_version"
    if [ -d "$release/core/root/web" ]; then
      install -d -m 0755 -o root -g root /var/www/llmide-web
      cp -a "$release/core/root/web/." /var/www/llmide-web/
      chown -R root:root /var/www/llmide-web
    fi
    # Keep current, previous and one older release.
    ls -1dt /opt/llmide/releases/* 2>/dev/null | sed -n '4,$p' | xargs -r rm -rf
    say "ok ($bundle_version)"
    ;;

  nginx)
    staging
    conf
    [ -f "$STAGING/llm-ide-hub.nginx" ] || die "llm-ide-hub.nginx is missing"
    cert="/etc/letsencrypt/live/$DOMAIN/fullchain.pem"
    renewal="/etc/letsencrypt/renewal/$DOMAIN.conf"
    if [ -f "$renewal" ] && ! grep -Eq '^[[:space:]]*reuse_key[[:space:]]*=[[:space:]]*True' "$renewal"; then
      die "the certificate was not issued with --reuse-key; run: certbot certonly --webroot -w /var/www/llmide-web -d $DOMAIN --key-type ecdsa --reuse-key"
    fi
    if [ ! -f "$cert" ]; then
      die "no certificate at $cert; run: certbot certonly --webroot -w /var/www/llmide-web -d $DOMAIN --key-type ecdsa --reuse-key"
    fi
    fp=$(openssl x509 -in "$cert" -pubkey -noout \
      | openssl pkey -pubin -outform der \
      | openssl dgst -sha256 -binary \
      | basenc --base64url | tr -d '=')
    printf 'sha256:%s\n' "$fp" > /etc/llmide/host-api-fingerprint
    chmod 0644 /etc/llmide/host-api-fingerprint; chown root:root /etc/llmide/host-api-fingerprint
    # Renewal hook: recompute the pin from the live cert so a renewed (reused-key) cert does not leave a stale file.
    install -d -m 0755 -o root -g root /etc/letsencrypt/renewal-hooks/deploy
    cat > /etc/letsencrypt/renewal-hooks/deploy/llmide-pin <<HOOK
#!/bin/sh
set -eu
cert=/etc/letsencrypt/live/$DOMAIN/fullchain.pem
[ -r "\$cert" ] || exit 0
fp=\$(openssl x509 -in "\$cert" -pubkey -noout | openssl pkey -pubin -outform der | openssl dgst -sha256 -binary | basenc --base64url | tr -d '=')
printf 'sha256:%s\\n' "\$fp" > /etc/llmide/host-api-fingerprint
chmod 0644 /etc/llmide/host-api-fingerprint
systemctl reload nginx 2>/dev/null || true
HOOK
    chmod 0755 /etc/letsencrypt/renewal-hooks/deploy/llmide-pin
    chown root:root /etc/letsencrypt/renewal-hooks/deploy/llmide-pin
    [ -f "$STAGING/setup.html" ] && install -m 0644 -o root -g root "$STAGING/setup.html" /var/www/llmide-web/setup.html || true
    backup=""
    rm -f /etc/nginx/sites-enabled/llm-ide-hub.bak.* 2>/dev/null || true
    if [ -f "$SITE" ]; then
      install -d -m 0700 -o root -g root /var/lib/llmide-deploy
      backup="/var/lib/llmide-deploy/llm-ide-hub.bak.$$"
      cp -p "$SITE" "$backup"
    fi
    sed "s/__DOMAIN__/$DOMAIN/g" "$STAGING/llm-ide-hub.nginx" > "$SITE"
    chmod 0644 "$SITE"; chown root:root "$SITE"
    if ! nginx -t; then
      if [ -n "$backup" ]; then
        cp -p "$backup" "$SITE"; rm -f "$backup"
        die "nginx rejected the vhost; the previous site was restored"
      fi
      # First install: there is no previous site, so leaving the rejected file would break
      # every later nginx -t (and certbot renewals). Remove it instead.
      rm -f "$SITE"
      die "nginx rejected the vhost; the new site was removed"
    fi
    systemctl reload nginx
    [ -n "$backup" ] && rm -f "$backup" || true
    say "ok"
    ;;

  start)
    [ -x /opt/llmide/current/core/node/node ] || die "no current release"
    systemctl enable llmide-core >/dev/null || die "could not enable llmide-core"
    systemctl restart llmide-core
    say "ok"
    ;;

  open-registration)
    conf
    token=$(cat)
    case "$token" in
      *[!A-Fa-f0-9]*|'') die "the bootstrap token must be hex" ;;
    esac
    printf 'LLMIDE_BOOTSTRAP_TOKEN=%s\n' "$token" > /etc/llmide/bootstrap.env
    chmod 0600 /etc/llmide/bootstrap.env; chown root:root /etc/llmide/bootstrap.env
    replace_line "$CONF" LLMIDE_DISABLE_REGISTRATION 0
    systemctl restart llmide-core
    printf 'LLMIDE_SETUP_URL=https://%s/setup#t=%s\n' "$DOMAIN" "$token"
    say "ok"
    ;;

  lock-registration)
    conf
    rm -f /etc/llmide/bootstrap.env
    replace_line "$CONF" LLMIDE_DISABLE_REGISTRATION 1
    systemctl restart llmide-core
    say "ok"
    ;;

  backup)
    systemctl start llmide-backup.service
    say "ok"
    ;;

  predeploy-backup)
    was_active=0
    systemctl is-active --quiet llmide-core 2>/dev/null && was_active=1 || true
    [ "$was_active" -eq 1 ] && systemctl stop llmide-core || true
    if [ -f /var/lib/llmide/data.db ]; then
      systemctl start llmide-backup.service || { [ "$was_active" -eq 1 ] && systemctl start llmide-core || true; die "the pre-deploy backup failed"; }
    fi
    [ "$was_active" -eq 1 ] && systemctl start llmide-core || true
    say "ok"
    ;;

  rollback)
    if [ ! -L /opt/llmide/previous ]; then die "no previous release to roll back to"; fi
    target=$(readlink -f /opt/llmide/previous) || die "the previous release is missing"
    [ -d "$target" ] || die "the previous release is missing"
    old=$(readlink -f /opt/llmide/current) || old=""
    ver=$(tr -cd '0-9.' < "$target/VERSION" 2>/dev/null | head -c 40)
    case "$ver" in *.*.*) ;; *) die "the previous release has no x.y.z VERSION" ;; esac
    # The web assets and the reported env version are part of the release: restore both
    # before switching, so the API and the PWA never disagree after a rollback.
    if [ -d "$target/core/root/web" ]; then
      install -d -m 0755 -o root -g root /var/www/llmide-web
      cp -a "$target/core/root/web/." /var/www/llmide-web/
      chown -R root:root /var/www/llmide-web
    fi
    replace_line "$CONF" LLMIDE_HUB_VERSION "$ver"
    if [ -n "$old" ] && [ "$old" != "$target" ]; then ln -sfn "$old" /opt/llmide/previous; fi
    ln -sfn "$target" /opt/llmide/current
    systemctl restart llmide-core
    say "ok ($ver)"
    ;;

  update)
    staging
    conf
    [ -f "$STAGING/VERSION" ] || die "VERSION is missing"
    new=$(tr -cd '0-9.' < "$STAGING/VERSION" | head -c 40)
    case "$new" in *.*.*) ;; *) die "the new version is not x.y.z" ;; esac
    current=$(cat /opt/llmide/current/VERSION 2>/dev/null || true)
    [ "$new" = "$current" ] && die "the hub already runs $new"
    if ! bundle_out=$("$0" bundle); then
      printf '%s\n' "$bundle_out"
      die "bundle failed before/after the switch"
    fi
    printf '%s\n' "$bundle_out"
    printf 'LLMIDE_UPDATE_SWITCHED=%s\n' "$new"
    replace_line "$CONF" LLMIDE_HUB_VERSION "$new"
    "$0" start
    say "ok ($new)"
    ;;

  uninstall)
    systemctl disable --now llmide-core 2>/dev/null || true
    rm -f "$UNIT" "$BACKUP_UNIT"
    systemctl daemon-reload 2>/dev/null || true
    rm -f "$SITE"
    nginx -t >/dev/null 2>&1 && systemctl reload nginx || true
    # conf() dies when core.env is absent/invalid; run it in a subshell so uninstall still
    # removes the helper and its NOPASSWD grant on a partially-installed host.
    domain=$( ( conf && printf '%s\n' "$DOMAIN" ) 2>/dev/null || true )
    if [ -n "$domain" ]; then
      printf 'certificate kept: certbot delete --cert-name %s\n' "$domain" >&2
    fi
    # Data is kept by default: /var/lib/llmide and /srv/llmide/projects stay for a manual restore.
    rm -f /etc/sudoers.d/llmide-deploy
    rm -f /usr/local/sbin/llmide-deploy
    say "ok (data kept)"
    ;;

  uninstall-purge)
    systemctl disable --now llmide-core 2>/dev/null || true
    rm -f "$UNIT" "$BACKUP_UNIT" "$SITE"
    systemctl daemon-reload 2>/dev/null || true
    nginx -t >/dev/null 2>&1 && systemctl reload nginx || true
    rm -rf /var/lib/llmide /var/lib/llmide-deploy /srv/llmide/projects /opt/llmide /etc/llmide
    rm -f /etc/sudoers.d/llmide-deploy
    rm -f /usr/local/sbin/llmide-deploy
    say "ok (data deleted)"
    ;;

  *)
    echo "llmide-deploy: unknown stage '$stage'" >&2
    exit 2
    ;;
esac
