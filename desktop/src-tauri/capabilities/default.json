{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Product surface of the main window: core status, secrets status (booleans only), graph read (project-root scoped), project open (host-run folder dialog, no dialog/fs plugin permission), tray + fixed-template notifications (no notification plugin permission), terminal, open_external_url (validated, confirmed links), reveal_in_os (project-scoped), attach_* (host file picker, opaque handles), bypass_confirm (native dialog). No fs/shell/opener/http plugin, no wildcard permissions.",
  "windows": ["main"],
  "permissions": [
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "allow-core-status",
    "allow-secrets-status",
    "allow-read-graph-file",
    "allow-project-open",
    "allow-project-open-recent",
    "allow-project-active",
    "allow-project-recent",
    "allow-fs-list-dir",
    "allow-fs-read-file",
    "allow-fs-read-range",
    "allow-fs-write-file",
    "allow-fs-create",
    "allow-fs-rename",
    "allow-fs-delete",
    "allow-fs-watch-start",
    "allow-fs-watch-set",
    "allow-fs-watch-stop",
    "allow-project-search-start",
    "allow-project-search-cancel",
    "allow-git-status",
    "allow-git-diff",
    "allow-git-show",
    "allow-git-stage",
    "allow-git-diff-hunks",
    "allow-git-stage-hunks",
    "allow-git-stage-all",
    "allow-git-discard",
    "allow-git-identity",
    "allow-git-commit",
    "allow-git-branches",
    "allow-git-checkout",
    "allow-git-create-branch",
    "allow-git-log",
    "allow-git-commit-files",
    "allow-git-commit-diff",
    "allow-notify",
    "allow-tray-status",
    "allow-tray-set-close-to-tray",
    "allow-pty-status",
    "allow-pty-retry-consent",
    "allow-pty-spawn",
    "allow-pty-write",
    "allow-pty-resize",
    "allow-pty-ack",
    "allow-pty-kill",
    "allow-notes-root-get",
    "allow-notes-root-choose",
    "allow-notes-root-clear",
    "allow-notes-list",
    "allow-notes-read",
    "allow-notes-heads",
    "allow-note-open",
    "allow-note-save",
    "allow-note-create",
    "allow-note-rename",
    "allow-notes-delete-many",
    "allow-chat-bind-session",
    "allow-chat-unbind-session",
    "allow-chat-list",
    "allow-chat-load",
    "allow-chat-save",
    "allow-chat-delete",
    "allow-chat-archive-status",
    "allow-open-external-url",
    "allow-reveal-in-os",
    "allow-attach-pick-files",
    "allow-attach-read",
    "allow-attach-release",
    "allow-bypass-confirm"
  ]
}
