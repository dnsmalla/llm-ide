{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Product surface of the main window: core status, secrets status (booleans only), graph read (project-root scoped), project open (host-run folder dialog, no dialog/fs plugin permission), tray + fixed-template notifications (no notification plugin permission), terminal. No fs/shell/opener/http plugin, no wildcard permissions.",
  "windows": ["main"],
  "permissions": [
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "allow-core-status",
    "allow-secrets-status",
    "allow-read-graph-file",
    "allow-project-open",
    "allow-project-open-recent",
    "allow-project-active",
    "allow-project-recent",
    "allow-fs-list-dir",
    "allow-fs-read-file",
    "allow-fs-read-range",
    "allow-fs-write-file",
    "allow-fs-create",
    "allow-fs-rename",
    "allow-fs-delete",
    "allow-fs-watch-start",
    "allow-fs-watch-set",
    "allow-fs-watch-stop",
    "allow-notify",
    "allow-tray-status",
    "allow-tray-set-close-to-tray",
    "allow-pty-spawn",
    "allow-pty-write",
    "allow-pty-resize",
    "allow-pty-ack",
    "allow-pty-kill",
    "allow-notes-root-get",
    "allow-notes-root-choose",
    "allow-notes-root-clear",
    "allow-notes-list",
    "allow-notes-read",
    "allow-notes-heads"
  ]
}
