{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@llmide/ui-kit": ["../ui/kit/src/index.ts"],
      "@llmide/screens/*": ["../ui/screens/*"],
      "@tauri-apps/api": ["./node_modules/@tauri-apps/api/index.d.ts"],
      "@tauri-apps/api/event": ["./node_modules/@tauri-apps/api/event.d.ts"],
      "graphology": ["./node_modules/graphology"],
      "sigma": ["./node_modules/sigma"],
      "qrcode-generator": ["./node_modules/qrcode-generator"],
      "react": ["./node_modules/@types/react"],
      "react/jsx-runtime": ["./node_modules/@types/react/jsx-runtime"],
      "react/jsx-dev-runtime": ["./node_modules/@types/react/jsx-dev-runtime"],
      "react-dom": ["./node_modules/@types/react-dom"]
    },
    "noEmit": true,
    "types": ["vite/client"]
  },
  "include": ["src", "../ui/kit/src", "../ui/screens", "vite.config.ts"]
}
