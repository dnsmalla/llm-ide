{
  "name": "llmide-desktop-poc",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node ../scripts/gen-design-tokens.mjs --check && node scripts/check-capabilities.mjs --product && tsc --noEmit && vite build",
    "tauri": "tauri",
    "tokens": "node ../scripts/gen-design-tokens.mjs",
    "test": "node --test --experimental-strip-types scripts/*.test.mjs ../ui/screens/shell/tests/*.test.mjs ../ui/screens/shell/tests/e2e/*.test.mjs ../ui/screens/welcome/tests/*.test.mjs ../ui/screens/settings/tests/*.test.* ../ui/screens/chat/tests/*.test.mjs ../ui/screens/library/tests/*.test.* ../ui/screens/library/extensions/tests/*.test.* ../ui/screens/explorer/tests/*.test.mjs ../ui/screens/explorer/scm/tests/*.test.mjs ../ui/screens/graph/tests/*.test.* ../ui/screens/docgen/tests/*.test.*",
    "check:security": "node scripts/check-capabilities.mjs && node scripts/check-dompurify.mjs",
    "check:security:product": "node scripts/check-capabilities.mjs --product && node scripts/check-dompurify.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "dompurify": "3.4.17",
    "graphology": "0.26.0",
    "graphology-layout-forceatlas2": "0.10.1",
    "graphology-types": "0.24.8",
    "monaco-editor": "0.57.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sigma": "3.0.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "esbuild": "0.28.2",
    "postject": "1.0.0-alpha.6",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "overrides": {
    "dompurify": "3.4.17"
  }
}
