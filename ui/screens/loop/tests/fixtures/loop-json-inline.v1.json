{
  "schemaVersion": 2,
  "loops": [
    {
      "id": "loop-test-1",
      "name": "Test",
      "isPrimary": false,
      "scopeGlobs": [],
      "defaultKey": "test",
      "runsOnSchedule": false,
      "config": {
        "stages": [
          {
            "id": "test/test-structure",
