{
  "endpoint": "PUT /kb/docs/templates/:folder",
  "status": 200,
  "description": "Captured by calling the real handler with rewrite: the title and section list are applied to the existing file and its body text is kept (the manager-sheet save).",
  "request": {
    "query": {
      "project": "alpha"
    },
    "params": {
      "folder": "retro"
    },
    "body": {
      "name": "Retro (weekly)",
      "sections": [
        "Went well"
      ],
      "rewrite": true
    }
  },
  "response": {
    "template": {
      "id": "65A8ADFC-2236-44D5-A676-C0DA368BBC91",
      "name": "Retro (weekly)",
      "sections": [
        "Went well"
      ],
      "rawContent": "# Retro (weekly)\n\n<!-- llmide:doc-template -->\n\n## Went well\n",
      "isBuiltin": false,
      "folderName": "retro",
      "isProjectTemplate": true,
      "surface": "doc"
    }
  }
}
