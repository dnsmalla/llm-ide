        "Improve"
      ],
      "rawContent": "# Retro\n\n<!-- llmide:doc-template -->\n\n## Went well\n\n## Improve\n",
      "isBuiltin": false,
      "folderName": "retro",
      "isProjectTemplate": true,
      "surface": "doc"
    }
  }
}
