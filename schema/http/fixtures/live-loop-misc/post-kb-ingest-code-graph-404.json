{
  "endpoint": "POST /kb/ingest-code-graph",
  "status": 404,
  "description": "Answers 404 feature_disabled when the Mac build has code_graph_3d off.",
  "request": {
    "body": {
      "repoPath": "/example/repo",
      "graph": {
        "nodes": [
          {
            "id": "file:src/app.ts",
            "title": "src/app.ts",
            "kind": "file",
            "metadata": {
              "source_file": "src/app.ts",
              "line": 1,
              "language": "typescript"
            }
          },
          {
            "id": "symbol:src/app.ts#main",
            "title": "main",
            "kind": "function",
            "metadata": {
              "source_file": "src/app.ts",
              "line": 12,
              "language": "typescript",
              "doc": "Entry point."
            }
          },
          {
            "title": "orphan without id",
            "kind": "function"
          }
        ],
        "edges": [
          {
            "fromId": "file:src/app.ts",
            "toId": "symbol:src/app.ts#main",
            "kind": "contains",
            "confidence": "EXTRACTED"
          }
        ]
      },
      "replace": true,
      "commitSha": "abc1234",
