{
  "endpoint": "PUT /kb/issue-schedule",
  "status": 401,
  "request": {
    "body": {
      "provider": "github",
      "repo": "example/repo",
      "issueNumber": 12,
      "startDate": "2026-11-02",
      "dueDate": "2026-11-06",
      "estimateDays": 3,
      "dependsOn": [
        10,
        11
      ]
    }
  },
  "response": {
    "error": {
