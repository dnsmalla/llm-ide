{
  "endpoint": "POST /kb/loop/agent-run",
  "status": 200,
  "description": "The engine stopped the step for no progress; the reason is carried through as noProgressReason.",
  "request": {
    "body": {
      "message": "Run the regression stage.",
      "skills": [
        "regression"
      ],
      "repoRoot": "/example/repo",
      "timeoutMs": 60000
    }
  },
  "response": {
    "reply": "",
    "changedPaths": [],
    "changedExtraPaths": [],
    "createdPaths": [],
