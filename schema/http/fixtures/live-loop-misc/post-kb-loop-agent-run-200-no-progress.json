      "inputTokens": 5000,
      "outputTokens": 90,
      "cacheReadTokens": 0,
      "cacheCreationTokens": 0,
      "costUsd": 0.01,
      "numTurns": 7,
      "durationMs": 22000
    },
    "resolvedSkills": [
      "regression"
    ],
    "unresolvedSkills": [],
