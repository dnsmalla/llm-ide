{
  "endpoint": "PUT /kb/issue-schedule",
  "status": 400,
  "request": {
    "body": {
      "provider": "jira",
      "repo": "example/repo",
      "issueNumber": 12,
      "startDate": "2026-11-02",
      "dueDate": "2026-11-06",
      "estimateDays": 3,
      "dependsOn": [
