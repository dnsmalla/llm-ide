{
  "endpoint": "POST /kb/index/scan",
  "status": 200,
  "description": "Example data. A single-chunk final scan of its own project: the chunk is complete, it classifies its one key as missing and prunes nothing.",
  "request": {
    "body": {
      "projectId": "scan-fixture",
      "scanId": "scan-0004-abcd",
      "index": 0,
      "total": 1,
      "complete": true,
      "prune": true,
      "entries": [
        {
          "noteKey": "meetings/2026/10/review.md",
          "contentHash": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
        }
      ]
    }
  },
  "response": {
    "missing": [
      "meetings/2026/10/review.md"
    ],
    "stale": [],
    "extra": [],
    "pruned": 0,
    "received": 1,
    "total": 1,
    "complete": true
  }
}
