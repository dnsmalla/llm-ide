  "endpoint": "POST /kb/google/options",
  "status": 200,
  "request": {
    "body": {
      "accountId": "0123456789ab",
      "product": "gmail",
      "options": {
        "labels": [
          "INBOX",
          "Label_1",
          "bad label!"
        ],
