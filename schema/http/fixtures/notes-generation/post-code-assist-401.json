{
  "endpoint": "POST /code-assist",
  "status": 401,
  "description": "Captured from `node extension/server.mjs` on a temp DB (LLMIDE_DB_PATH in TMPDIR), replayed over HTTP. No model call: the Claude CLI path points at a missing binary. Handler: code-assist.",
  "request": {
    "body": {
      "message": "Review this file.",
      "history": [
        {
          "role": "user",
          "content": "Hi"
        }
      ],
      "attachments": [
        {
          "path": "src/app.ts",
          "content": "export const x = 1;\n"
        }
      ],
      "skills": [
        "code-review"
      ],
      "language": "en",
      "model": "claude-haiku-5-5",
      "provider": "anthropic",
      "tier": "subagent",
      "mode": "auto",
      "planExecute": false,
      "planWrite": false,
      "clientCaps": [
        "ask_user"
      ],
      "agentContext": {
        "sessionId": "legacy-session-1",
        "chatSessionId": "chat-1",
        "activeProject": {
          "id": "proj-1",
          "name": "Example"
        },
        "indexedRepos": [
          {
            "id": "repo-1",
            "path": "/example/repo"
          }
        ],
        "recentIssues": [
          {
            "id": "ISSUE-1",
            "title": "Example issue"
          }
        ],
        "workspaceRoot": "/example/repo",
        "activeRepoRoot": "/example/repo"
      }
    }
  },
  "response": {
    "error": {
      "code": "AUTH_REQUIRED",
      "message": "Missing access token"
    }
  }
}
