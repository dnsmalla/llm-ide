{
  "endpoint": "POST /kb/routing-tiers",
  "status": 200,
  "description": "Captured from `node extension/server.mjs` on a temp DB (LLMIDE_DB_PATH in TMPDIR, LLMIDE_ENGINE_PREWARM=0), replayed over HTTP. No model call and no external network. The image tier and chatPlanning feature are not server roles and are dropped (unknown_tier / unknown_feature).",
  "request": {
    "body": {
      "tiers": {
        "strong": {
          "provider": "anthropic",
          "model": "claude-sonnet-5-5"
        },
        "standard": {
          "provider": "custom:example-glm",
          "model": "example-model"
        },
        "cheap": {
          "provider": "deepseek",
          "model": "deepseek-chat"
        },
        "image": {
          "provider": "openai",
          "model": "gpt-image"
        }
      },
      "features": {
        "subagents": "strong",
        "internal": "standard",
        "loop": "cheap",
        "chatPlanning": "strong"
      }
    }
  },
  "response": {
    "success": true,
    "dropped": [
      {
        "entry": "tiers.image",
        "reason": "unknown_tier"
      },
      {
        "entry": "features.chatPlanning",
        "reason": "unknown_feature"
      }
    ]
  }
}
