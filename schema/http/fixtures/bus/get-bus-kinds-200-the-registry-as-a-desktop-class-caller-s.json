{
  "endpoint": "GET /bus/kinds",
  "status": 200,
  "description": "the registry as a desktop-class caller sees it",
  "response": {
    "v": 1,
    "client": "desktop-ui",
    "registryVersion": 1,
    "limits": {
      "maxCommandBytes": 65536,
      "maxResultBytes": 262144,
      "maxActiveCommands": 20,
      "maxPendingApprovals": 20
    },
    "kinds": [
      {
        "kind": "review",
        "tier": "T0",
        "lane": "read",
        "write": false,
        "available": true,
        "description": "Read-only review of a registered project (code, docs or merge conflicts) on a chosen engine.",
        "engines": [
          "claude",
          "adapter"
        ],
        "engineStatus": [
          {
            "id": "claude",
            "available": true
          },
          {
            "id": "adapter",
            "available": true
          },
          {
            "id": "codex",
            "available": false,
            "reason": "ENGINE_NOT_SANDBOXED"
          },
          {
            "id": "gemini",
            "available": false,
            "reason": "ENGINE_NOT_SANDBOXED"
          }
        ],
        "args": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "focus",
            "projectId"
          ],
          "properties": {
            "focus": {
              "type": "string",
              "enum": [
                "code",
                "doc",
                "conflicts"
              ]
            },
            "projectId": {
              "type": "string",
              "x-format": "id"
            },
            "engine": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "provider"
              ],
              "properties": {
                "provider": {
                  "type": "string",
                  "x-format": "provider"
                },
                "model": {
                  "type": "string",
                  "x-format": "model"
                },
                "credential": {
                  "type": "string",
                  "enum": [
                    "cli-login",
                    "api-key"
                  ]
                }
              }
            }
          }
        },
        "enabled": false,
        "allowed": true,
        "needsApproval": false,
        "runner": "core"
      },
      {
        "kind": "sources.update",
        "tier": "T1",
        "lane": "write",
        "write": true,
        "available": false,
        "description": "Fetch email, Slack and document sources into the Library and re-index.",
        "engines": [],
        "engineStatus": [],
        "args": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sourceIds": {
              "type": "array",
              "maxItems": 50,
              "items": {
                "type": "string",
                "x-format": "id"
              }
            }
          }
        },
        "enabled": false,
        "allowed": true,
        "needsApproval": false,
        "unavailableReason": "Node has no source registry: connector credentials and source lists live in the Mac app (email, Slack) or are sent per request (Box); no server-side refresh exists to adapt.",
        "runner": "core"
      },
      {
        "kind": "issues.from_notes",
        "tier": "T1",
        "lane": "write",
        "write": true,
        "available": true,
        "runner": "core",
        "description": "Extract action items from the project's meeting notes and create issues on a repository already on the Issues board; each action is filed once.",
        "engines": [],
        "engineStatus": [],
        "args": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "projectId",
            "provider",
            "repo"
          ],
          "properties": {
            "projectId": {
              "type": "string",
              "x-format": "id"
            },
            "provider": {
              "type": "string",
              "enum": [
                "github",
                "gitlab"
              ]
            },
            "repo": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "since": {
              "type": "string",
              "x-format": "date"
            }
          }
        },
        "enabled": false,
        "allowed": true,
        "needsApproval": true
      },
      {
        "kind": "issues.implement",
        "tier": "T2",
        "lane": "write",
        "write": true,
        "available": true,
        "description": "Run the Factory on approved issues, one card per issue in its own worktree. The desktop claims the approved command, runs it under its concurrency cap and reports progress; `ship` never ships (the run stops at Ready to ship and a desktop click is still the only Ship).",
        "engines": [],
        "engineStatus": [],
        "args": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "projectId",
            "issueIds"
          ],
          "properties": {
            "projectId": {
              "type": "string",
              "x-format": "id"
            },
            "issueIds": {
              "type": "array",
              "minItems": 1,
              "maxItems": 20,
              "items": {
                "type": "string",
                "x-format": "id"
              }
            },
            "ship": {
              "type": "boolean"
            }
          }
        },
        "enabled": false,
        "allowed": true,
        "needsApproval": true,
        "runner": "desktop"
      },
      {
        "kind": "loop.run",
        "tier": "T1",
        "lane": "write",
        "write": true,
        "available": false,
        "description": "Run one of the project's Loops (or one stage) with edits inside its declared scope.",
        "engines": [],
        "engineStatus": [],
        "args": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "projectId",
            "loopId"
          ],
          "properties": {
            "projectId": {
              "type": "string",
              "x-format": "id"
            },
            "loopId": {
              "type": "string",
              "x-format": "id"
            },
            "stageId": {
              "type": "string",
              "x-format": "id"
            }
          }
        },
        "enabled": false,
        "allowed": true,
        "needsApproval": false,
        "unavailableReason": "Loop definitions (stages, verify commands, scope) live in the Mac app; Node has only the confined agent step (POST /kb/loop/agent-run), which needs the composed stage prompt.",
        "runner": "core"
      },
      {
        "kind": "custom.run",
        "tier": "T1",
        "lane": "write",
        "write": true,
        "available": false,
        "description": "Run a saved custom task by id (the prompt is part of the saved task, never of the command).",
        "engines": [],
        "engineStatus": [],
        "args": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "customTaskId"
          ],
          "properties": {
            "customTaskId": {
              "type": "string",
              "x-format": "id"
            }
          }
        },
        "enabled": false,
        "allowed": true,
        "needsApproval": false,
        "unavailableReason": "Saved custom tasks (named prompt, cron, project) live in the Mac app; Node has no store to resolve a customTaskId.",
        "runner": "core"
      }
    ]
  }
}
