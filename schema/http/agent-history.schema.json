{
  "description": "Agent history (Stage 1c): storage report, retention, clear with a signed preview, compact. Always on (plan Q5). Per-user; the previewId binds a real clear to the dry run it came from.",
  "endpoints": {
    "GET /kb/storage": {
      "responses": {
        "200": {
          "$ref": "#/$defs/StorageReport"
        }
      }
    },
    "GET /kb/agent-history/settings": {
      "responses": {
        "200": {
          "type": "object",
          "required": [
            "retentionDays",
            "rollupKeepDays",
            "min",
            "max"
          ],
          "properties": {
            "retentionDays": {
              "type": "integer",
              "description": "Raw-row retention in days, clamped to min..max."
            },
            "rollupKeepDays": {
              "type": "integer",
              "description": "Daily rollups are kept this long."
            },
            "min": {
              "type": "integer"
            },
            "max": {
              "type": "integer"
            }
          }
        }
      }
    },
    "PUT /kb/agent-history/settings": {
      "request": {
        "body": {
          "type": "object",
          "required": [
            "retentionDays"
          ],
          "properties": {
            "retentionDays": {
              "description": "A whole number of days, clamped to 7..365. Any other value is a 400 VALIDATION_FAILED."
            }
          }
        }
      },
      "responses": {
        "200": {
          "type": "object",
          "required": [
            "retentionDays",
            "rollupKeepDays",
            "min",
            "max"
          ],
          "properties": {
            "retentionDays": {
              "type": "integer",
              "description": "Raw-row retention in days, clamped to min..max."
            },
            "rollupKeepDays": {
              "type": "integer",
              "description": "Daily rollups are kept this long."
            },
            "min": {
              "type": "integer"
            },
            "max": {
              "type": "integer"
            }
          }
        },
        "400": {
          "$ref": "_common#/$defs/Error"
        },
        "503": {
          "x-unspecified": "Store unavailable or disk short: the status is set by the route (routes/agent-history.mjs); the Error envelope is the same as the other 4xx/5xx answers and needs a store outage to produce, so no fixture captures it."
        }
      }
    },
    "POST /kb/agent-history/clear": {
      "request": {
        "body": {
          "type": "object",
          "required": [
            "scope"
          ],
          "properties": {
            "scope": {
              "type": "string",
              "enum": [
                "raw",
                "all"
              ]
            },
            "beforeDays": {
              "type": [
                "integer",
                "null"
              ],
              "description": "Only rows older than this many days; omit for all."
            },
            "dryRun": {
              "type": "boolean",
              "description": "Default true: a dry run. false performs the clear and needs previewId."
            },
            "previewId": {
              "type": "string",
              "description": "From a dry run of the same scope and cutoff."
            }
          }
        }
      },
      "responses": {
        "200": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "dryRun",
                "scope",
                "beforeDays",
                "wouldDelete",
                "total",
                "previewId",
                "expiresAt"
              ],
              "properties": {
                "dryRun": {
                  "type": "boolean",
                  "const": true
                },
                "scope": {
                  "type": "string",
                  "enum": [
                    "raw",
                    "all"
                  ]
                },
                "beforeDays": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "wouldDelete": {
                  "type": "object",
                  "required": [
                    "agent_runs",
                    "agent_tool_events",
                    "turn_composition",
                    "agent_daily",
                    "agent_daily_tools"
                  ],
                  "properties": {
                    "agent_runs": {
                      "type": "integer"
                    },
                    "agent_tool_events": {
                      "type": "integer"
                    },
                    "turn_composition": {
                      "type": "integer"
                    },
                    "agent_daily": {
                      "type": "integer"
                    },
                    "agent_daily_tools": {
                      "type": "integer"
                    }
                  }
                },
                "total": {
                  "type": "integer"
                },
                "previewId": {
                  "type": "string",
                  "description": "Signed by the server; valid five minutes for this user, scope and cutoff."
                },
                "expiresAt": {
                  "type": "string"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "dryRun",
                "scope",
                "beforeDays",
                "deleted",
                "total"
              ],
              "properties": {
                "dryRun": {
                  "type": "boolean",
                  "const": false
                },
                "scope": {
                  "type": "string",
                  "enum": [
                    "raw",
                    "all"
                  ]
                },
                "beforeDays": {
                  "type": [
                    "integer",
                    "null"
                  ]
                },
                "deleted": {
                  "type": "object",
                  "required": [
                    "agent_runs",
                    "agent_tool_events",
                    "turn_composition",
                    "agent_daily",
                    "agent_daily_tools"
                  ],
                  "properties": {
                    "agent_runs": {
                      "type": "integer"
                    },
                    "agent_tool_events": {
                      "type": "integer"
                    },
                    "turn_composition": {
                      "type": "integer"
                    },
                    "agent_daily": {
                      "type": "integer"
                    },
                    "agent_daily_tools": {
                      "type": "integer"
                    }
                  }
                },
                "total": {
                  "type": "integer"
                }
              }
            }
          ]
        },
        "400": {
          "$ref": "_common#/$defs/Error"
        },
        "409": {
          "$ref": "_common#/$defs/Error"
        },
        "503": {
          "x-unspecified": "Store unavailable or disk short: the status is set by the route (routes/agent-history.mjs); the Error envelope is the same as the other 4xx/5xx answers and needs a store outage to produce, so no fixture captures it."
        }
      },
      "description": "A dry run returns the counts a real clear would delete and a previewId. A real clear needs that previewId (PREVIEW_REQUIRED if absent). Errors: PREVIEW_INVALID (400) for another user, scope or cutoff, a tampered token, a replay (a preview is single use), or an unknown token; PREVIEW_EXPIRED (400) for a preview past its five minutes or signed before a server restart (the page asks for a new dry run for both); preview_stale (409) when the rows changed since the preview. A clear never deletes the tool events or composition rows of a run still running."
    },
    "POST /kb/agent-history/compact": {
      "responses": {
        "200": {
          "type": "object",
          "required": [
            "ok",
            "mode",
            "pagesFreed",
            "bytesBefore",
            "bytesAfter",
            "ms"
          ],
          "properties": {
            "ok": {
              "type": "boolean",
              "const": true
            },
            "mode": {
              "type": "string",
              "enum": [
                "incremental",
                "full"
              ]
            },
            "pagesFreed": {
              "type": "integer"
            },
            "bytesBefore": {
              "type": "integer"
            },
            "bytesAfter": {
              "type": "integer"
            },
            "ms": {
              "type": "integer"
            }
          }
        },
        "409": {
          "$ref": "_common#/$defs/Error"
        },
        "507": {
          "x-unspecified": "Store unavailable or disk short: the status is set by the route (routes/agent-history.mjs); the Error envelope is the same as the other 4xx/5xx answers and needs a store outage to produce, so no fixture captures it."
        },
        "503": {
          "x-unspecified": "Store unavailable or disk short: the status is set by the route (routes/agent-history.mjs); the Error envelope is the same as the other 4xx/5xx answers and needs a store outage to produce, so no fixture captures it."
        }
      }
    }
  },
  "$defs": {
    "StorageGroup": {
      "type": "object",
      "description": "One data group of the Storage hub. agent_history carries bytes (approximate) and the clear/compact actions; the main-DB groups carry rows per user and no bytes (SQLite sizes whole files, not users).",
      "required": [
        "key",
        "label",
        "rows",
        "bytes",
        "bytesApprox",
        "lastCleanedAt",
        "retentionDays",
        "actions"
      ],
      "properties": {
        "key": {
          "type": "string",
          "enum": [
            "agent_history",
            "search_index",
            "code_graph",
            "sources",
            "meetings"
          ]
        },
        "label": {
          "type": "string"
        },
        "rows": {
          "type": "integer",
          "description": "Rows for this user. agent_history: runs, tool events and composition rows (the rows Clear can delete; the activity feed is not counted). search_index: indexed chunks. code_graph: repos. sources: distinct source kinds. meetings: meetings."
        },
        "bytes": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Approximate bytes for agent_history; null for the main-DB groups."
        },
        "bytesApprox": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "lastCleanedAt": {
          "type": [
            "string",
            "null"
          ],
          "description": "ISO time of the last clear (agent_history only)."
        },
        "retentionDays": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Raw-row retention (agent_history only)."
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "clear",
              "compact"
            ]
          },
          "description": "Actions the page may offer. Only agent_history has any."
        }
      }
    },
    "AgentHistorySummary": {
      "type": [
        "object",
        "null"
      ],
      "description": "Null when the agent store is down.",
      "required": [
        "rawFromDay",
        "rawRows",
        "rolledDays",
        "oldestDay",
        "quarantinedAt",
        "droppedRows",
        "watermark"
      ],
      "properties": {
        "rawFromDay": {
          "type": [
            "string",
            "null"
          ],
          "description": "Oldest raw day (YYYY-MM-DD, local)."
        },
        "rawRows": {
          "type": "integer"
        },
        "rolledDays": {
          "type": "integer"
        },
        "oldestDay": {
          "type": [
            "string",
            "null"
          ],
          "description": "Oldest rolled-up day."
        },
        "quarantinedAt": {
          "type": [
            "string",
            "null"
          ],
          "description": "When the store was reset after damage, if it was."
        },
        "droppedRows": {
          "type": "integer",
          "description": "Rows dropped by the write queue (bounded queue or failed batch), counted since the store was created."
        },
        "watermark": {
          "type": [
            "string",
            "null"
          ],
          "description": "The last day folded into the daily rollups."
        }
      }
    },
    "StorageReport": {
      "type": "object",
      "required": [
        "generatedAt",
        "groups",
        "agentHistory",
        "agentStore"
      ],
      "properties": {
        "generatedAt": {
          "type": "string"
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StorageGroup"
          }
        },
        "agentHistory": {
          "$ref": "#/$defs/AgentHistorySummary"
        },
        "agentStore": {
          "type": "object",
          "required": [
            "health",
            "state"
          ],
          "properties": {
            "health": {
              "type": "string",
              "enum": [
                "ok",
                "degraded",
                "down"
              ]
            },
            "state": {
              "type": "string",
              "enum": [
                "closed",
                "ok",
                "down"
              ]
            }
          }
        }
      }
    },
    "AgentRun": {
      "type": "object",
      "description": "One agent run for the System view. No prompt, message or error text: codes only.",
      "required": [
        "id",
        "source",
        "engine",
        "status",
        "startedAt",
        "endedAt",
        "durationMs",
        "tokens",
        "toolCalls",
        "model",
        "errorCode"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "enum": [
            "chat",
            "loop",
            "meeting",
            "autotask",
            "dispatch",
            "review"
          ]
        },
        "engine": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "running",
            "ok",
            "error",
            "cancelled",
            "aborted"
          ]
        },
        "startedAt": {
          "type": "string"
        },
        "endedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "durationMs": {
          "type": [
            "integer",
            "null"
          ]
        },
        "tokens": {
          "type": "integer",
          "description": "Input plus output tokens of the run."
        },
        "toolCalls": {
          "type": "integer"
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "errorCode": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
