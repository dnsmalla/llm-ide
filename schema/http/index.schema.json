{
  "description": "The derived note index (live-then-archive Phase 1, plan 3.8). Always on, per user and per project. The index is rebuildable from the Mac note files and holds no unique data: body_text is a redacted, capped copy (200 KiB, UTF-8) built when the row is written. Hidden notes are never stored (skippedHidden counts them). Chunked scans (POST /kb/index/scan) let a library larger than one reconcile request be checked; only a complete final chunk may prune.",
  "$defs": {
    "Note": {
      "type": "object",
      "required": [
        "noteKey",
        "title",
        "date",
        "contentHash"
      ],
      "properties": {
        "noteKey": {
          "type": "string",
          "description": "Relative path under the project root, forward slashes. No leading slash, no .. segments."
        },
        "projectId": {
          "type": "string",
          "description": "Optional; defaults to the batch projectId."
        },
        "kind": {
          "type": "string",
          "enum": [
            "meeting",
            "note",
            "email",
            "slack",
            "document",
            "repo",
            "plan",
            "other"
          ],
          "description": "meeting (default) is the Mac's meeting notes; the others let the Library index its other sources. Any other value is refused with 400."
        },
        "title": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "description": "Note start, ISO."
        },
        "durationSec": {
          "type": "integer"
        },
        "participants": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "body": {
          "type": "string",
          "description": "The note body. Redacted and capped on write."
        },
        "contentHash": {
          "type": "string",
          "description": "SHA-256 of the Mac file bytes."
        },
        "mtimeMs": {
          "type": "integer"
        },
        "hidden": {
          "type": "boolean",
          "description": "true: counted in skippedHidden and not stored."
        },
        "meta": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "ManifestEntry": {
      "type": "object",
      "required": [
        "noteKey",
        "contentHash"
      ],
      "properties": {
        "noteKey": {
          "type": "string"
        },
        "contentHash": {
          "type": "string"
        }
      }
    }
  },
  "endpoints": {
    "POST /kb/index/notes": {
      "request": {
        "body": {
          "type": "object",
          "required": [
            "notes"
          ],
          "properties": {
            "projectId": {
              "type": "string"
            },
            "notes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Note"
              },
              "description": "At most 50 per batch (BATCH_TOO_LARGE, 400); a body over 1 MB is 413 PAYLOAD_TOO_LARGE; a note body over 512 KiB is a 400."
            }
          }
        }
      },
      "responses": {
        "200": {
          "type": "object",
          "required": [
            "upserted",
            "unchanged",
            "skippedHidden",
            "truncated",
            "removed"
          ],
          "properties": {
            "upserted": {
              "type": "integer",
              "description": "Rows written (new or changed)."
            },
            "unchanged": {
              "type": "integer",
              "description": "Rows whose content already matched; nothing was written."
            },
            "skippedHidden": {
              "type": "integer"
            },
            "truncated": {
              "type": "integer",
              "description": "Rows whose body was capped at 200 KiB."
            },
            "removed": {
              "type": "integer",
              "description": "Rows removed because the note is now hidden (it was indexed while visible)."
            }
          }
        },
        "400": {
          "$ref": "_common#/$defs/Error"
        }
      }
    },
    "POST /kb/index/reconcile": {
      "request": {
        "body": {
          "type": "object",
          "required": [
            "manifest"
          ],
          "properties": {
            "projectId": {
              "type": "string"
            },
            "manifest": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ManifestEntry"
              },
              "description": "At most 20 000 entries."
            },
            "prune": {
              "type": "boolean",
              "description": "true deletes the extra rows. Default false: report only."
            },
            "keep": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Keys the Mac could not index (unparseable, unavailable, unsendable). They are never pruned and are not reported as extra. At most 20 000."
            },
            "allowEmpty": {
              "type": "boolean",
              "description": "Required with prune: true and an empty manifest. Without it that request is refused (409 EMPTY_MANIFEST_REFUSED), so an emptied or unmounted folder cannot delete the index."
            }
          }
        }
      },
      "responses": {
        "200": {
          "type": "object",
          "required": [
            "missing",
            "stale",
            "extra",
            "pruned"
          ],
          "properties": {
            "missing": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "In the manifest, not indexed."
            },
            "stale": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Indexed with a different content hash."
            },
            "extra": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Indexed, not in the manifest."
            },
            "pruned": {
              "type": "integer",
              "description": "Rows deleted (only with prune true)."
            }
          }
        },
        "400": {
          "$ref": "_common#/$defs/Error"
        },
        "409": {
          "$ref": "_common#/$defs/Error"
        }
      }
    },
    "DELETE /kb/index/notes/:key": {
      "request": {
        "params": {
          "type": "object",
          "required": [
            "key"
          ],
          "properties": {
            "key": {
              "type": "string",
              "description": "The note key, percent-encoded."
            }
          }
        },
        "query": {
          "type": "object",
          "properties": {
            "projectId": {
              "type": "string"
            }
          }
        }
      },
      "responses": {
        "200": {
          "type": "object",
          "required": [
            "deleted"
          ],
          "properties": {
            "deleted": {
              "type": "boolean"
            }
          }
        },
        "400": {
          "$ref": "_common#/$defs/Error"
        }
      }
    },
    "GET /kb/index/search": {
      "request": {
        "query": {
          "type": "object",
          "required": [
            "q"
          ],
          "properties": {
            "q": {
              "type": "string",
              "description": "1 to 200 characters. Words of 2+ characters are matched against title and the redacted body; a query with none returns no results."
            },
            "limit": {
              "type": "string",
              "description": "Integer 1 to 50; the default is 20."
            },
            "projectId": {
              "type": "string",
              "description": "At most 200 characters. Omit to search every project of the user."
            }
          }
        }
      },
      "responses": {
        "200": {
          "type": "object",
          "required": [
            "results"
          ],
          "properties": {
            "results": {
              "type": "array",
              "description": "Best match first. Only the caller's own notes.",
              "items": {
                "type": "object",
                "required": [
                  "noteKey",
                  "title",
                  "snippet",
                  "date",
                  "kind",
                  "projectId"
                ],
                "properties": {
                  "noteKey": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "snippet": {
                    "type": "string",
                    "description": "Plain text, at most about 200 characters around the first matched word: control, bidi and zero-width characters removed, secrets redacted. Never markup."
                  },
                  "date": {
                    "type": "string",
                    "description": "Note start, ISO."
                  },
                  "kind": {
                    "type": "string"
                  },
                  "projectId": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "400": {
          "$ref": "_common#/$defs/Error"
        }
      }
    },
    "GET /kb/index/status": {
      "request": {
        "query": {
          "type": "object",
          "properties": {
            "projectId": {
              "type": "string",
              "description": "Omit for every project of the user."
            }
          }
        }
      },
      "responses": {
        "200": {
          "type": "object",
          "required": [
            "notes",
            "ftsRows",
            "consistent",
            "lastIndexedAt"
          ],
          "properties": {
            "notes": {
              "type": "integer"
            },
            "ftsRows": {
              "type": "integer",
              "description": "Search rows written by those notes."
            },
            "consistent": {
              "type": "boolean",
              "description": "true when notes equals ftsRows."
            },
            "lastIndexedAt": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "POST /kb/index/scan": {
      "request": {
        "body": {
          "type": "object",
          "required": [
            "scanId",
            "index",
            "total",
            "entries"
          ],
          "properties": {
            "projectId": {
              "type": "string"
            },
            "scanId": {
              "type": "string",
              "description": "8 to 64 letters, digits or dashes; one value per scan, chosen by the client."
            },
            "index": {
              "type": "integer",
              "description": "0-based chunk number, below total."
            },
            "total": {
              "type": "integer",
              "description": "Chunks in the scan (1 to 100). Every chunk of one scan repeats it."
            },
            "complete": {
              "type": "boolean",
              "description": "true on the final chunk: the scan is compared with the index. Default false."
            },
            "prune": {
              "type": "boolean",
              "description": "true (final chunk only) deletes the rows no chunk named. Default false."
            },
            "entries": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ManifestEntry"
              },
              "description": "At most 500 per chunk."
            },
            "totalEntries": {
              "type": "integer",
              "description": "Final chunk only: the entries the whole scan carries. The server compares it with the sum of the received chunks (409 SCAN_TOTAL_MISMATCH)."
            },
            "keep": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Final chunk only: keys never pruned (unindexable on the Mac)."
            },
            "allowEmpty": {
              "type": "boolean",
              "description": "Final chunk only: an all-empty scan with prune is refused (409 EMPTY_SCAN_REFUSED) unless this is true."
            }
          }
        }
      },
      "responses": {
        "200": {
          "type": "object",
          "required": [
            "missing",
            "stale",
            "extra",
            "pruned",
            "received",
            "total",
            "complete"
          ],
          "properties": {
            "missing": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Keys in this chunk that the index lacks."
            },
            "stale": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Keys in this chunk indexed with another hash."
            },
            "extra": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Final chunk only: indexed keys no chunk named."
            },
            "pruned": {
              "type": "integer",
              "description": "Final chunk with prune: rows deleted."
            },
            "received": {
              "type": "integer",
              "description": "Chunks of this scan received so far."
            },
            "total": {
              "type": "integer"
            },
            "complete": {
              "type": "boolean"
            }
          }
        },
        "400": {
          "$ref": "_common#/$defs/Error"
        },
        "409": {
          "$ref": "_common#/$defs/Error"
        }
      }
    }
  }
}
