{
  "description": "Chat lifecycle and live-capture acks (live-then-archive Phase 1, plan sections 3.2-3.6). Always on; nothing in the chat or meeting flow calls them yet. Working-state purges delete server rows and SDK transcripts only; the Mac chat file is the transcript and is never touched here. Archive begin and commit are the fenced protocol of plan 3.3: the archive hash is SHA-256 over the messages in order, each as the UTF-8 byte length of its role, a colon, the role, the byte length of its content, a colon, the content (no separators, so no two message lists collide). An empty list hashes to the SHA-256 of the empty string.",
  "$defs": {
    "WorkingChat": {
      "type": "object",
      "required": [
        "chatSessionId",
        "sdkSession",
        "factCount",
        "updatedAt"
      ],
      "properties": {
        "chatSessionId": {
          "type": "string",
          "description": "The Mac chat UUID."
        },
        "sdkSession": {
          "type": [
            "string",
            "null"
          ],
          "description": "The Agent SDK session the chat resumes, when one is mapped."
        },
        "factCount": {
          "type": "integer",
          "description": "Session-memory facts kept for the chat."
        },
        "updatedAt": {
          "type": [
            "string",
            "null"
          ],
          "description": "ISO time the chat's SDK mapping was last used; null when only facts remain."
        }
      }
    },
    "ArchiveMessage": {
      "type": "object",
      "required": [
        "seq",
        "role",
        "content",
        "meta",
        "createdAt"
      ],
      "properties": {
        "seq": {
          "type": "integer"
        },
        "role": {
          "type": "string",
          "enum": [
            "user",
            "assistant",
            "system"
          ]
        },
        "content": {
          "type": "string"
        },
        "meta": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true,
          "description": "The message metadata the chat store kept, or null."
        },
        "createdAt": {
          "type": "number",
          "description": "Seconds since the epoch, as the chat store records it."
        }
      }
    }
  },
  "endpoints": {
    "GET /kb/agent/working-state": {
      "responses": {
        "200": {
          "type": "object",
          "required": [
            "sessions",
            "purges"
          ],
          "properties": {
            "sessions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/WorkingChat"
              }
            },
            "purges": {
              "type": "object",
              "required": [
                "pending",
                "failed"
              ],
              "properties": {
                "pending": {
                  "type": "integer",
                  "description": "Tombstones still retrying (with backoff)."
                },
                "failed": {
                  "type": "array",
                  "description": "Tombstones that gave up after the attempt cap; resolve them, they do not retry.",
                  "items": {
                    "type": "object",
                    "required": [
                      "chatSessionId",
                      "attempts"
                    ],
                    "properties": {
                      "chatSessionId": {
                        "type": "string"
                      },
                      "attempts": {
                        "type": "integer"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "POST /agent/v2/sessions/purge": {
      "request": {
        "body": {
          "type": "object",
          "required": [
            "chatSessionIds",
            "verified"
          ],
          "properties": {
            "chatSessionIds": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Up to 500 non-empty chat ids. Every chat needs an archive receipt (a server commit, or POST /kb/archive-receipts); otherwise 409 NO_RECEIPT and nothing is purged."
            },
            "verified": {
              "type": "boolean",
              "description": "Must be true: the caller has checked the Mac file. Any other value is a 400 VALIDATION_FAILED."
            }
          }
        }
      },
      "responses": {
        "200": {
          "type": "object",
          "required": [
            "purged"
          ],
          "properties": {
            "purged": {
              "type": "integer",
              "description": "Chats whose working state was removed. Unknown ids count as zero; the call is idempotent."
            }
          }
        },
        "400": {
          "$ref": "_common#/$defs/Error"
        },
        "409": {
          "$ref": "_common#/$defs/Error"
        }
      }
    },
    "POST /kb/session-purges": {
      "request": {
        "body": {
          "type": "object",
          "required": [
            "chatSessionId"
          ],
          "properties": {
            "chatSessionId": {
              "type": "string"
            },
            "reason": {
              "type": "string",
              "description": "user_delete (default) or meeting_end. Any other value is a 400 VALIDATION_FAILED."
            }
          }
        }
      },
      "responses": {
        "202": {
          "type": "object",
          "required": [
            "queued",
            "purged"
          ],
          "properties": {
            "queued": {
              "const": true,
              "description": "The tombstone is durable before the purge is attempted."
            },
            "purged": {
              "type": "string",
              "enum": [
                "done",
                "pending",
                "failed"
              ],
              "description": "done: working state, transcripts and server chat rows are gone. pending: retried later with backoff. failed: gave up after the attempt cap (see working-state)."
            }
          }
        },
        "400": {
          "$ref": "_common#/$defs/Error"
        }
      }
    },
    "POST /kb/chat/sessions/:id/archive/begin": {
      "request": {
        "params": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string"
            }
          }
        },
        "query": {
          "type": "object",
          "properties": {
            "after": {
              "type": "integer",
              "description": "A continuation page: the seq of the last message on the previous page. Needs fence."
            },
            "fence": {
              "type": "integer",
              "description": "The fence of the initial begin. Required with after; a mismatch is 409 ARCHIVE_STALE."
            },
            "limit": {
              "type": "integer",
              "description": "Messages per page: default 200, at most 500. A page is also cut at about 8 MB."
            }
          }
        }
      },
      "responses": {
        "200": {
          "type": "object",
          "required": [
            "fence",
            "count",
            "hash",
            "incomplete",
            "session",
            "messages",
            "nextAfter"
          ],
          "properties": {
            "fence": {
              "type": "integer",
              "description": "Bumped by every begin. The commit must present it."
            },
            "count": {
              "type": "integer"
            },
            "hash": {
              "type": "string",
              "description": "64 lower-case hex: the digest of ALL the chat's messages, streamed (not just this page)."
            },
            "session": {
              "type": "object",
              "required": [
                "id",
                "title",
                "surface",
                "mode",
                "projectId",
                "createdAt",
                "updatedAt"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "surface": {
                  "type": "string"
                },
                "mode": {
                  "type": "string"
                },
                "projectId": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "createdAt": {
                  "type": "number"
                },
                "updatedAt": {
                  "type": "number"
                }
              }
            },
            "messages": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ArchiveMessage"
              },
              "description": "Every message, in order. No cap (plan Q8)."
            },
            "incomplete": {
              "type": "object",
              "required": [
                "incomplete",
                "prunedMessages",
                "truncatedMessages"
              ],
              "properties": {
                "incomplete": {
                  "type": "boolean",
                  "description": "True when the live store dropped messages (the 2000-message prune or the 64 KB content cap). The commit refuses unless acceptIncomplete is sent."
                },
                "prunedMessages": {
                  "type": "integer"
                },
                "truncatedMessages": {
                  "type": "integer"
                }
              }
            },
            "nextAfter": {
              "type": [
                "integer",
                "null"
              ],
              "description": "The seq to pass as after for the next page, or null on the last page."
            }
          }
        },
        "404": {
          "$ref": "_common#/$defs/Error"
        },
        "409": {
          "$ref": "_common#/$defs/Error"
        }
      }
    },
    "POST /kb/chat/sessions/:id/archive/commit": {
      "request": {
        "params": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string"
            }
          }
        },
        "body": {
          "type": "object",
          "required": [
            "fence",
            "hash"
          ],
          "properties": {
            "fence": {
              "type": "integer"
            },
            "hash": {
              "type": "string",
              "description": "The 64-hex hash the begin returned, recomputed over the file the Mac wrote."
            },
            "acceptIncomplete": {
              "type": "boolean",
              "description": "Archive a chat the caps made incomplete. Without it such a commit is 409 INCOMPLETE_ARCHIVE."
            }
          }
        }
      },
      "responses": {
        "200": {
          "type": "object",
          "required": [
            "deleted",
            "status"
          ],
          "properties": {
            "deleted": {
              "type": "boolean",
              "description": "True when this call removed the rows."
            },
            "status": {
              "type": "string",
              "enum": [
                "deleted",
                "already_archived"
              ],
              "description": "already_archived: the chat is gone and a receipt with this hash says it was archived (idempotent). A chat that is gone without such a receipt is 404."
            }
          }
        },
        "400": {
          "$ref": "_common#/$defs/Error"
        },
        "409": {
          "$ref": "_common#/$defs/Error"
        },
        "404": {
          "$ref": "_common#/$defs/Error"
        }
      }
    },
    "POST /kb/live/:id/ack": {
      "request": {
        "params": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string"
            }
          }
        },
        "body": {
          "type": "object",
          "required": [
            "noteKey",
            "hash",
            "lines"
          ],
          "properties": {
            "noteKey": {
              "type": "string",
              "description": "The relative path of the Mac note that holds the capture."
            },
            "hash": {
              "type": "string",
              "description": "SHA-256 of the verified file."
            },
            "lines": {
              "type": "integer",
              "description": "Transcript lines in the verified file."
            }
          }
        }
      },
      "responses": {
        "200": {
          "type": "object",
          "required": [
            "sessionId",
            "state",
            "ackedAt",
            "idempotent"
          ],
          "properties": {
            "sessionId": {
              "type": "string"
            },
            "state": {
              "const": "acked"
            },
            "ackedAt": {
              "type": "string"
            },
            "idempotent": {
              "type": "boolean",
              "description": "True when this capture was already acked."
            }
          }
        },
        "400": {
          "$ref": "_common#/$defs/Error"
        },
        "404": {
          "$ref": "_common#/$defs/Error"
        },
        "409": {
          "$ref": "_common#/$defs/Error"
        }
      }
    },
    "GET /kb/live/:id/status": {
      "request": {
        "params": {
          "type": "object",
          "required": [
            "id"
          ],
          "properties": {
            "id": {
              "type": "string"
            }
          }
        }
      },
      "responses": {
        "200": {
          "type": "object",
          "required": [
            "sessionId",
            "state",
            "durable",
            "expiresAt"
          ],
          "properties": {
            "sessionId": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "enum": [
                "live",
                "finalized",
                "acked",
                "expired",
                "unknown"
              ],
              "description": "live: still capturing (a live session wins over any ack). finalized: waiting for the ack; durable says whether a restart keeps it. acked: the Mac acked it. expired: not acked within 7 days, the capture was dropped and logged. unknown: the server has no record; the extension keeps its draft."
            },
            "durable": {
              "type": "boolean",
              "description": "True when a finalized capture is stored durably (survives a restart)."
            },
            "expiresAt": {
              "type": [
                "string",
                "null"
              ],
              "description": "When an unacked durable capture expires (7 days after finalize)."
            }
          }
        }
      }
    },
    "GET /kb/live/unacked": {
      "responses": {
        "200": {
          "type": "object",
          "required": [
            "sessions"
          ],
          "properties": {
            "sessions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "sessionId",
                  "meetingTitle",
                  "startedAt",
                  "captionCount",
                  "lines",
                  "hash",
                  "durable",
                  "source"
                ],
                "properties": {
                  "sessionId": {
                    "type": "string"
                  },
                  "meetingTitle": {
                    "type": "string"
                  },
                  "startedAt": {
                    "type": [
                      "number",
                      "string"
                    ]
                  },
                  "captionCount": {
                    "type": [
                      "integer",
                      "null"
                    ],
                    "description": "Null for a database-only capture (after a restart); read its transcript from the meeting."
                  },
                  "source": {
                    "type": "string",
                    "enum": [
                      "memory",
                      "database"
                    ]
                  },
                  "durationSec": {
                    "type": "integer",
                    "description": "Only for database-source rows."
                  },
                  "lines": {
                    "type": "integer",
                    "description": "Caption lines the server holds. The ack must echo it."
                  },
                  "hash": {
                    "type": "string",
                    "description": "SHA-256 (64 hex) of the redacted transcript the server holds. The ack must echo it."
                  },
                  "durable": {
                    "type": "boolean"
                  },
                  "expiresAt": {
                    "type": "string",
                    "description": "Database-source rows only."
                  }
                }
              }
            }
          }
        }
      }
    },
    "POST /kb/archive-receipts": {
      "request": {
        "body": {
          "type": "object",
          "required": [
            "chatSessionId",
            "hash",
            "count"
          ],
          "properties": {
            "chatSessionId": {
              "type": "string"
            },
            "hash": {
              "type": "string",
              "description": "64 lower-case hex: the archive hash the Mac computed over the file it wrote."
            },
            "count": {
              "type": "integer",
              "description": "Messages in that file."
            }
          }
        }
      },
      "responses": {
        "200": {
          "type": "object",
          "required": [
            "recorded"
          ],
          "properties": {
            "recorded": {
              "const": true,
              "description": "The receipt is stored; purging the chat's working state is now allowed."
            }
          }
        },
        "400": {
          "$ref": "_common#/$defs/Error"
        }
      }
    }
  }
}
