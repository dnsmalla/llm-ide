{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://llm-ide.local/schema/bus/event.schema.json",
  "title": "Command bus result event",
  "description": "One event of a command (docs/spec/command-bus.md section 1.2), the data: payload of GET /bus/commands/:id/events (the SSE `id:` equals seq). seq is per command, starts at 1 and is gap-free; exactly one event has terminal:true (ended or error) and it is the last. Payloads are redacted by the core before they leave. Every variant sets additionalProperties:false.",
  "type": "object",
  "required": ["v", "cmd", "seq", "type", "payload", "terminal", "at"],
  "oneOf": [
    {
      "title": "accepted",
      "description": "The command was received: queued, waiting for a desktop approval, or already running.",
      "additionalProperties": false,
      "required": ["v", "cmd", "seq", "type", "payload", "terminal", "at"],
      "properties": {
        "v": { "type": "integer" },
        "cmd": { "type": "string" },
        "seq": { "type": "integer" },
        "type": { "const": "accepted" },
        "terminal": { "const": false },
        "at": { "type": "integer", "description": "Desktop clock, ms, advisory." },
        "payload": {
          "type": "object", "additionalProperties": false, "required": ["kind", "tier", "state"],
          "properties": {
            "kind": { "type": "string" },
            "tier": { "type": "string", "enum": ["R", "C", "T0", "T1", "T2", "D"] },
            "state": { "type": "string", "enum": ["awaiting_approval", "queued"] }
          }
        }
      }
    },
    {
      "title": "progress",
      "description": "A step label while the command runs.",
      "additionalProperties": false,
      "required": ["v", "cmd", "seq", "type", "payload", "terminal", "at"],
      "properties": {
        "v": { "type": "integer" },
        "cmd": { "type": "string" },
        "seq": { "type": "integer" },
        "type": { "const": "progress" },
        "terminal": { "const": false },
        "at": { "type": "integer" },
        "payload": {
          "type": "object", "additionalProperties": false, "required": ["step"],
          "properties": {
            "step": { "type": "string" },
            "note": { "type": "string", "x-optional": true }
          }
        }
      }
    },
    {
      "title": "chunk",
      "description": "A piece of streamed text output (engine reply).",
      "additionalProperties": false,
      "required": ["v", "cmd", "seq", "type", "payload", "terminal", "at"],
      "properties": {
        "v": { "type": "integer" },
        "cmd": { "type": "string" },
        "seq": { "type": "integer" },
        "type": { "const": "chunk" },
        "terminal": { "const": false },
        "at": { "type": "integer" },
        "payload": {
          "type": "object", "additionalProperties": false, "required": ["text"],
          "properties": { "text": { "type": "string" } }
        }
      }
    },
    {
      "title": "data",
      "description": "A named, bounded value produced by the command. The value's keys are open: they are typed per (kind, name) by the kind's own documentation, not by this envelope.",
      "additionalProperties": false,
      "required": ["v", "cmd", "seq", "type", "payload", "terminal", "at"],
      "properties": {
        "v": { "type": "integer" },
        "cmd": { "type": "string" },
        "seq": { "type": "integer" },
        "type": { "const": "data" },
        "terminal": { "const": false },
        "at": { "type": "integer" },
        "payload": {
          "type": "object", "additionalProperties": false, "required": ["name", "value"],
          "properties": {
            "name": { "type": "string" },
            "value": { "type": "object", "additionalProperties": true }
          }
        }
      }
    },
    {
      "title": "needs_approval",
      "description": "The command waits for a desktop approval. The approval nonce is never in an event: only a desktop-class client reads it from GET /bus/approvals.",
      "additionalProperties": false,
      "required": ["v", "cmd", "seq", "type", "payload", "terminal", "at"],
      "properties": {
        "v": { "type": "integer" },
        "cmd": { "type": "string" },
        "seq": { "type": "integer" },
        "type": { "const": "needs_approval" },
        "terminal": { "const": false },
        "at": { "type": "integer" },
        "payload": {
          "type": "object", "additionalProperties": false, "required": ["tier", "reason"],
          "properties": {
            "tier": { "type": "string", "enum": ["R", "C", "T0", "T1", "T2", "D"] },
            "reason": { "type": "string", "enum": ["tier", "switch_off"] }
          }
        }
      }
    },
    {
      "title": "needs_answer",
      "description": "The command asks the user a question (reserved: no S3 kind emits it yet).",
      "additionalProperties": false,
      "required": ["v", "cmd", "seq", "type", "payload", "terminal", "at"],
      "properties": {
        "v": { "type": "integer" },
        "cmd": { "type": "string" },
        "seq": { "type": "integer" },
        "type": { "const": "needs_answer" },
        "terminal": { "const": false },
        "at": { "type": "integer" },
        "payload": {
          "type": "object", "additionalProperties": false, "required": ["requestId", "question"],
          "properties": { "requestId": { "type": "string" }, "question": { "type": "string" } }
        }
      }
    },
    {
      "title": "ended",
      "description": "Terminal: the command finished (succeeded) or was cancelled. The result is bounded and redacted.",
      "additionalProperties": false,
      "required": ["v", "cmd", "seq", "type", "payload", "terminal", "at"],
      "properties": {
        "v": { "type": "integer" },
        "cmd": { "type": "string" },
        "seq": { "type": "integer" },
        "type": { "const": "ended" },
        "terminal": { "const": true },
        "at": { "type": "integer" },
        "payload": {
          "type": "object", "additionalProperties": false, "required": ["state"],
          "properties": {
            "state": { "type": "string", "enum": ["succeeded", "cancelled"] },
            "result": { "type": "object", "additionalProperties": true, "x-optional": true, "description": "The kind's result; keys are typed per kind." }
          }
        }
      }
    },
    {
      "title": "error",
      "description": "Terminal: the command did not run or failed. code is one of registry.errorCodes; message is short human text with no stack, path or secret.",
      "additionalProperties": false,
      "required": ["v", "cmd", "seq", "type", "payload", "terminal", "at"],
      "properties": {
        "v": { "type": "integer" },
        "cmd": { "type": "string" },
        "seq": { "type": "integer" },
        "type": { "const": "error" },
        "terminal": { "const": true },
        "at": { "type": "integer" },
        "payload": {
          "type": "object", "additionalProperties": false, "required": ["code", "message"],
          "properties": {
            "code": { "type": "string", "enum": ["invalid_args", "unknown_kind", "unsupported_version", "tier_denied", "switch_off", "needs_desktop_approval", "expired", "duplicate", "idem_conflict", "engine_not_logged_in", "engine_no_key", "rate_limited", "quota_exceeded", "payload_too_large", "desktop_busy", "not_found", "kind_not_available", "project_not_registered", "project_not_allowed", "engine_failed", "read_only_violated", "interrupted", "timeout", "cancelled", "server_restarted", "internal"] },
            "message": { "type": "string" }
          }
        }
      }
    }
  ]
}
