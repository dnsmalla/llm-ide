{
  "version": 1,
  "limits": { "maxFrameBytes": 1048576, "defaultListItems": 100, "maxListItems": 500, "maxListBytes": 786432 },
  "capabilities": ["host", "chat", "approvals", "tool_approvals", "read", "compose"],
  "commands": {
    "host.hello": {
      "capability": "host",
      "direction": "client_to_host",
      "idempotent": true,
      "v2Tag": null,
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": ["clientName", "clientVersion", "platform", "apiVersions"],
        "properties": {
          "clientName": { "type": "string", "minLength": 1, "maxLength": 120 },
          "clientVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
          "platform": { "type": "string", "enum": ["ios", "web", "desktop", "mac"] },
          "apiVersions": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "minItems": 1 }
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": ["hostName", "hostKind", "apiVersion", "apiVersions", "capabilities", "protocolVersion", "requiresAuth"],
        "properties": {
          "hostName": { "type": "string", "minLength": 1, "maxLength": 120 },
          "hostKind": { "type": "string", "enum": ["mac", "desktop"] },
          "apiVersion": { "type": "integer", "const": 1 },
          "apiVersions": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "minItems": 1 },
          "capabilities": {
            "type": "array",
            "items": { "type": "string", "enum": ["host", "chat", "approvals", "tool_approvals", "read", "compose"] },
            "minItems": 1
          },
          "protocolVersion": { "type": "integer", "minimum": 1 },
          "requiresAuth": { "type": "boolean" },
          "certificateFingerprint": { "type": "string", "maxLength": 200 }
        }
      }
    },
    "host.auth.pair": {
      "capability": "host",
      "direction": "client_to_host",
      "idempotent": false,
      "v2Tag": "pairing",
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pin"],
        "properties": {
          "pin": { "type": "string", "pattern": "^[0-9]{6}$" }
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": ["token", "capabilities"],
        "properties": {
          "token": { "type": "string", "minLength": 16, "maxLength": 512 },
          "capabilities": {
            "type": "array",
            "items": { "type": "string", "enum": ["host", "chat", "approvals", "tool_approvals", "read", "compose"] },
            "minItems": 1
          }
        }
      }
    },
    "host.auth.token": {
      "capability": "host",
      "direction": "client_to_host",
      "idempotent": true,
      "v2Tag": null,
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": ["token"],
        "properties": {
          "token": { "type": "string", "minLength": 16, "maxLength": 512 }
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capabilities"],
        "properties": {
          "capabilities": {
            "type": "array",
            "items": { "type": "string", "enum": ["host", "chat", "approvals", "tool_approvals", "read", "compose"] },
            "minItems": 1
          }
        }
      }
    },
    "host.auth.revoke": {
      "capability": "host",
      "direction": "client_to_host",
      "idempotent": true,
      "v2Tag": null,
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": ["token"],
        "properties": {
          "token": { "type": "string", "minLength": 16, "maxLength": 512 }
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": ["revoked"],
        "properties": {
          "revoked": { "type": "boolean" }
        }
      }
    },
    "host.ping": {
      "capability": "host",
      "direction": "client_to_host",
      "idempotent": true,
      "v2Tag": "heartbeat",
      "request": { "type": "object", "additionalProperties": false, "properties": {} },
      "result": { "type": "object", "additionalProperties": false, "properties": {} }
    },
    "host.snapshot": {
      "capability": "host",
      "direction": "client_to_host",
      "idempotent": true,
      "v2Tag": null,
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": ["topics"],
        "properties": {
          "topics": {
            "type": "array",
            "items": { "type": "string", "enum": ["chat", "status", "autotasks", "loop"] },
            "minItems": 1,
            "maxItems": 4
          }
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": ["snapshots"],
        "properties": {
          "snapshots": {
            "type": "object",
            "description": "Per-domain snapshot payloads are opaque in v1; clients should request the typed domain snapshot command for a concrete shape.",
            "additionalProperties": { "type": "object" }
          }
        }
      }
    },
    "chat.snapshot": {
      "capability": "chat",
      "direction": "client_to_host",
      "idempotent": true,
      "v2Tag": "llmide_chat_history_list",
      "request": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "limit": { "type": "integer", "minimum": 1, "maximum": 500 }
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": ["messages"],
        "properties": {
          "messages": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["role", "content"],
              "properties": {
                "role": { "type": "string", "enum": ["user", "assistant"] },
                "content": { "type": "string", "maxLength": 100000 }
              }
            },
            "maxItems": 500
          }
        }
      }
    },
    "chat.send": {
      "capability": "chat",
      "direction": "client_to_host",
      "idempotent": false,
      "v2Tag": "llmide_chat",
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text"],
        "properties": {
          "text": { "type": "string", "minLength": 1, "maxLength": 100000 },
          "mode": { "type": "string", "enum": ["auto", "ask", "plan", "assist_plan", "review", "document"] },
          "model": { "type": "string", "pattern": "^[A-Za-z0-9_.:\\[\\]-]{1,200}$" },
          "attachments": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "text"],
              "properties": {
                "name": { "type": "string", "minLength": 1, "maxLength": 300 },
                "text": { "type": "string", "maxLength": 100000 }
              }
            },
            "maxItems": 10
          }
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": ["accepted"],
        "properties": {
          "accepted": { "type": "boolean" },
          "requestId": { "type": "string", "minLength": 1, "maxLength": 64 }
        }
      }
    },
    "chat.cancel": {
      "capability": "chat",
      "direction": "client_to_host",
      "idempotent": true,
      "v2Tag": "llmide_cancel",
      "request": { "type": "object", "additionalProperties": false, "properties": {} },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cancelled"],
        "properties": {
          "cancelled": { "type": "boolean" }
        }
      }
    },
    "chat.history.clear": {
      "capability": "chat",
      "direction": "client_to_host",
      "idempotent": true,
      "v2Tag": "llmide_chat_history_clear",
      "request": { "type": "object", "additionalProperties": false, "properties": {} },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cleared"],
        "properties": {
          "cleared": { "type": "boolean" }
        }
      }
    },
    "approvals.answer": {
      "capability": "approvals",
      "direction": "client_to_host",
      "idempotent": false,
      "v2Tag": "approval_answer",
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requestId", "commandId", "answers"],
        "properties": {
          "requestId": { "type": "string", "minLength": 1, "maxLength": 64 },
          "commandId": { "type": "string", "minLength": 1, "maxLength": 64 },
          "answers": {
            "type": "object",
            "additionalProperties": { "type": "string", "maxLength": 2000 }
          }
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": ["accepted"],
        "properties": {
          "accepted": { "type": "boolean" }
        }
      }
    },
    "toolApprovals.answer": {
      "capability": "tool_approvals",
      "direction": "client_to_host",
      "idempotent": false,
      "v2Tag": "tool_approval_answer",
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requestId", "commandId", "decision"],
        "properties": {
          "requestId": { "type": "string", "minLength": 1, "maxLength": 64 },
          "commandId": { "type": "string", "minLength": 1, "maxLength": 64 },
          "decision": { "type": "string", "enum": ["allow_once", "deny"] }
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": ["accepted"],
        "properties": {
          "accepted": { "type": "boolean" }
        }
      }
    },
    "chat.sessions": {
      "capability": "read",
      "direction": "client_to_host",
      "idempotent": true,
      "v2Tag": null,
      "request": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "limit": { "type": "integer", "minimum": 1, "maximum": 100 },
          "offset": { "type": "integer", "minimum": 0, "maximum": 10000 }
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sessions"],
        "properties": {
          "sessions": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "title", "updatedAt"],
              "properties": {
                "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
                "title": { "type": "string", "minLength": 1, "maxLength": 120 },
                "updatedAt": { "type": "integer", "minimum": 0 },
                "phoneChat": { "type": "boolean" }
              }
            }
          },
          "nextOffset": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "chat.history": {
      "capability": "read",
      "direction": "client_to_host",
      "idempotent": true,
      "v2Tag": null,
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sessionId"],
        "properties": {
          "sessionId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
          "beforeSeq": { "type": "integer", "minimum": 1 },
          "limit": { "type": "integer", "minimum": 1, "maximum": 500 }
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": ["messages"],
        "properties": {
          "messages": {
            "type": "array",
            "maxItems": 500,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["seq", "role", "content"],
              "properties": {
                "seq": { "type": "integer", "minimum": 1 },
                "role": { "type": "string", "enum": ["user", "assistant"] },
                "content": { "type": "string", "maxLength": 100000 }
              }
            }
          },
          "nextBeforeSeq": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "usage.get": {
      "capability": "read",
      "direction": "client_to_host",
      "idempotent": true,
      "v2Tag": "usage_get",
      "request": { "type": "object", "additionalProperties": false, "properties": {} },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": ["providers"],
        "properties": {
          "providers": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["provider", "status", "models"],
              "properties": {
                "provider": { "type": "string", "minLength": 1, "maxLength": 64 },
                "status": { "type": "string", "enum": ["ok", "degraded", "paused", "unconfigured"] },
                "activeModel": { "type": "string", "minLength": 1, "maxLength": 200 },
                "models": {
                  "type": "array",
                  "maxItems": 50,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["model", "state", "unit", "window", "used", "limit", "resetAt"],
                    "properties": {
                      "model": { "type": "string", "minLength": 1, "maxLength": 200 },
                      "label": { "type": "string", "minLength": 1, "maxLength": 200 },
                      "state": { "type": "string", "enum": ["ok", "warning", "exhausted"] },
                      "unit": { "type": "string", "enum": ["runs", "tokens"] },
                      "window": { "type": "string", "enum": ["daily", "monthly"] },
                      "used": { "type": "integer", "minimum": 0 },
                      "limit": { "type": "integer", "minimum": 0 },
                      "pct": { "type": "integer", "minimum": 0, "maximum": 999 },
                      "resetAt": { "type": "integer", "minimum": 0 }
                    }
                  }
                }
              }
            }
          }
        }
      }

    },
    "chat.options": {
      "capability": "compose",
      "direction": "client_to_host",
      "idempotent": true,
      "v2Tag": null,
      "request": { "type": "object", "additionalProperties": false, "properties": {} },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": ["modes", "models"],
        "properties": {
          "modes": { "type": "array", "minItems": 1, "maxItems": 6, "items": { "type": "string", "enum": ["auto", "ask", "plan", "assist_plan", "review", "document"] } },
          "models": { "type": "array", "maxItems": 50, "items": { "type": "object", "additionalProperties": false, "required": ["model"], "properties": { "model": { "type": "string", "pattern": "^[A-Za-z0-9_.:\\[\\]-]{1,200}$" }, "label": { "type": "string", "minLength": 1, "maxLength": 200 } } } }
        }
      }
    },
    "chat.new": {
      "capability": "compose",
      "direction": "client_to_host",
      "idempotent": false,
      "v2Tag": null,
      "request": { "type": "object", "additionalProperties": false, "properties": {} },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sessionId"],
        "properties": { "sessionId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" } }
      }
    }
  }
}
