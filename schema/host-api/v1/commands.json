{
  "version": 1,
  "limits": { "maxFrameBytes": 1048576, "defaultListItems": 100, "maxListItems": 500 },
  "capabilities": ["host", "chat", "approvals", "tool_approvals"],
  "commands": {
    "host.hello": {
      "capability": "host",
      "direction": "client_to_host",
      "idempotent": true,
      "v2Tag": null,
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": ["clientName", "clientVersion", "platform", "apiVersions"],
        "properties": {
          "clientName": { "type": "string", "minLength": 1, "maxLength": 120 },
          "clientVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
          "platform": { "type": "string", "enum": ["ios", "web", "desktop", "mac"] },
          "apiVersions": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "minItems": 1 }
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": ["hostName", "hostKind", "apiVersion", "apiVersions", "capabilities", "protocolVersion", "requiresAuth"],
        "properties": {
          "hostName": { "type": "string", "minLength": 1, "maxLength": 120 },
          "hostKind": { "type": "string", "enum": ["mac", "desktop"] },
          "apiVersion": { "type": "integer", "const": 1 },
          "apiVersions": { "type": "array", "items": { "type": "integer", "minimum": 1 }, "minItems": 1 },
          "capabilities": {
            "type": "array",
            "items": { "type": "string", "enum": ["host", "chat", "approvals", "tool_approvals"] },
            "minItems": 1
          },
          "protocolVersion": { "type": "integer", "minimum": 1 },
          "requiresAuth": { "type": "boolean" },
          "certificateFingerprint": { "type": "string", "maxLength": 200 }
        }
      }
    },
    "host.auth.pair": {
      "capability": "host",
      "direction": "client_to_host",
      "idempotent": false,
      "v2Tag": "pairing",
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pin"],
        "properties": {
          "pin": { "type": "string", "pattern": "^[0-9]{6}$" }
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": ["token", "capabilities"],
        "properties": {
          "token": { "type": "string", "minLength": 16, "maxLength": 512 },
          "capabilities": {
            "type": "array",
            "items": { "type": "string", "enum": ["host", "chat", "approvals", "tool_approvals"] },
            "minItems": 1
          }
        }
      }
    },
    "host.auth.token": {
      "capability": "host",
      "direction": "client_to_host",
      "idempotent": true,
      "v2Tag": null,
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": ["token"],
        "properties": {
          "token": { "type": "string", "minLength": 16, "maxLength": 512 }
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capabilities"],
        "properties": {
          "capabilities": {
            "type": "array",
            "items": { "type": "string", "enum": ["host", "chat", "approvals", "tool_approvals"] },
            "minItems": 1
          }
        }
      }
    },
    "host.auth.revoke": {
      "capability": "host",
      "direction": "client_to_host",
      "idempotent": true,
      "v2Tag": null,
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": ["token"],
        "properties": {
          "token": { "type": "string", "minLength": 16, "maxLength": 512 }
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": ["revoked"],
        "properties": {
          "revoked": { "type": "boolean" }
        }
      }
    },
    "host.ping": {
      "capability": "host",
      "direction": "client_to_host",
      "idempotent": true,
      "v2Tag": "heartbeat",
      "request": { "type": "object", "additionalProperties": false, "properties": {} },
      "result": { "type": "object", "additionalProperties": false, "properties": {} }
    },
    "host.snapshot": {
      "capability": "host",
      "direction": "client_to_host",
      "idempotent": true,
      "v2Tag": null,
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": ["topics"],
        "properties": {
          "topics": {
            "type": "array",
            "items": { "type": "string", "enum": ["chat", "status", "autotasks", "loop"] },
            "minItems": 1,
            "maxItems": 4
          }
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": ["snapshots"],
        "properties": {
          "snapshots": { "type": "object" }
        }
      }
    },
    "chat.snapshot": {
      "capability": "chat",
      "direction": "client_to_host",
      "idempotent": true,
      "v2Tag": "llmide_chat_history_list",
      "request": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "limit": { "type": "integer", "minimum": 1, "maximum": 500 }
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": ["messages"],
        "properties": {
          "messages": { "type": "array", "items": { "type": "object" }, "maxItems": 500 }
        }
      }
    },
    "chat.send": {
      "capability": "chat",
      "direction": "client_to_host",
      "idempotent": false,
      "v2Tag": "llmide_chat",
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text"],
        "properties": {
          "text": { "type": "string", "minLength": 1, "maxLength": 100000 },
          "attachments": { "type": "array", "items": { "type": "object" }, "maxItems": 10 }
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": ["accepted"],
        "properties": {
          "accepted": { "type": "boolean" },
          "requestId": { "type": "string", "minLength": 1, "maxLength": 64 }
        }
      }
    },
    "chat.cancel": {
      "capability": "chat",
      "direction": "client_to_host",
      "idempotent": true,
      "v2Tag": "llmide_cancel",
      "request": { "type": "object", "additionalProperties": false, "properties": {} },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cancelled"],
        "properties": {
          "cancelled": { "type": "boolean" }
        }
      }
    },
    "chat.history.clear": {
      "capability": "chat",
      "direction": "client_to_host",
      "idempotent": true,
      "v2Tag": "llmide_chat_history_clear",
      "request": { "type": "object", "additionalProperties": false, "properties": {} },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": ["cleared"],
        "properties": {
          "cleared": { "type": "boolean" }
        }
      }
    },
    "approvals.answer": {
      "capability": "approvals",
      "direction": "client_to_host",
      "idempotent": false,
      "v2Tag": "approval_answer",
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requestId", "commandId", "answers"],
        "properties": {
          "requestId": { "type": "string", "minLength": 1, "maxLength": 64 },
          "commandId": { "type": "string", "minLength": 1, "maxLength": 64 },
          "answers": {
            "type": "object",
            "additionalProperties": { "type": "string", "maxLength": 2000 }
          }
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": ["accepted"],
        "properties": {
          "accepted": { "type": "boolean" }
        }
      }
    },
    "toolApprovals.answer": {
      "capability": "tool_approvals",
      "direction": "client_to_host",
      "idempotent": false,
      "v2Tag": "tool_approval_answer",
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": ["requestId", "commandId", "decision"],
        "properties": {
          "requestId": { "type": "string", "minLength": 1, "maxLength": 64 },
          "commandId": { "type": "string", "minLength": 1, "maxLength": 64 },
          "decision": { "type": "string", "enum": ["allow_once", "deny"] }
        }
      },
      "result": {
        "type": "object",
        "additionalProperties": false,
        "required": ["accepted"],
        "properties": {
          "accepted": { "type": "boolean" }
        }
      }
    }
  }
}
