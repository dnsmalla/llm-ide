{
  "version": 1,
  "tasks": [
    {
      "id": "loop.regression",
      "label": "Regression",
      "group": "Maintenance",
      "description": "Re-check every status:fixed fault report and reopen the ones that no longer verify.",
      "aliases": [
        "regression"
      ],
      "runner": {
        "kind": "shell",
        "stage": {
          "kind": "regressionSweep",
          "name": "Regression",
          "severity": "blocking",
          "allowsRepair": true
        },
        "timeoutSeconds": 1800
      },
      "input": {
        "kind": "project",
        "required": true,
        "paths": [
          "system/faults"
        ]
      },
      "output": {
        "kind": "fault-report",
        "persist": "run-record",
        "revertWrites": false
      },
      "schedule": {
        "backend": "desktop",
        "defaultCron": null,
        "schedulable": true
      },
      "scope": "project",
      "readOnly": false,
      "requiresRepo": true,
      "requiresLocalHost": true,
      "features": [],
      "availability": {
        "status": "available",
        "reason": null
      },
      "revision": 1
    },
    {
      "id": "sources.update",
      "label": "Source Update",
      "group": "Pipeline",
      "description": "Sync the connected server-side sources into the Library and record what changed.",
      "aliases": [
        "sourceUpdate"
      ],
      "runner": {
        "kind": "core-route",
        "route": "sources-update",
        "busKind": "sources.update",
        "args": {
          "sourceIds": {
            "type": "string[]",
            "maxLength": 128,
            "maxItems": 50
          }
        },
        "timeoutSeconds": 1800
      },
      "input": {
        "kind": "project",
        "required": false,
        "paths": []
      },
      "output": {
        "kind": "text",
        "persist": "run-record",
        "revertWrites": false
      },
      "schedule": {
        "backend": "desktop",
        "defaultCron": null,
        "schedulable": true
      },
      "scope": "app",
      "readOnly": false,
      "requiresRepo": false,
      "requiresLocalHost": false,
      "features": [],
      "availability": {
        "status": "available",
        "reason": null
      },
      "revision": 1
    },
    {
      "id": "plan.status",
      "label": "Update Plan Status",
      "group": "Automation",
      "description": "Refresh the tracked outcomes and plan-task status from the connected trackers.",
      "aliases": [
        "updatePlanStatus"
      ],
      "runner": {
        "kind": "core-route",
        "route": "plan-status",
        "needs": [
          "trackerCreds"
        ],
        "timeoutSeconds": 1800
      },
      "input": {
        "kind": "none",
        "required": false,
        "paths": []
      },
      "output": {
        "kind": "none",
        "persist": "run-record",
        "revertWrites": false
      },
      "schedule": {
        "backend": "desktop",
        "defaultCron": null,
        "schedulable": true
      },
      "scope": "app",
      "readOnly": false,
      "requiresRepo": false,
      "requiresLocalHost": false,
      "features": [],
      "availability": {
        "status": "available",
        "reason": null
      },
      "revision": 1
    },
    {
      "id": "knowledge.update",
      "label": "Knowledge",
      "group": "Maintenance",
      "description": "Update the project knowledge base with durable facts. There is no durable writer in the core yet.",
      "aliases": [
        "generateKnowledge"
      ],
      "runner": null,
      "input": {
        "kind": "none",
        "required": false,
        "paths": []
      },
      "output": {
        "kind": "none",
        "persist": "none",
        "revertWrites": false
      },
      "schedule": {
        "backend": "none",
        "defaultCron": null,
        "schedulable": false
      },
      "scope": "project",
      "readOnly": true,
      "requiresRepo": false,
      "requiresLocalHost": false,
      "features": [],
      "availability": {
        "status": "retired",
        "reason": "No durable memory writer exists in the core; Graph/Memory surfaces own knowledge updates."
      },
      "revision": 1
    },
    {
      "id": "docs.generate",
      "label": "Generate Documentation",
      "group": "Automation",
      "description": "Generate a document through Doc Gen. The Doc Gen screen and POST /generate-doc own it.",
      "aliases": [
        "generateDoc"
      ],
      "runner": null,
      "input": {
        "kind": "doc",
        "required": false,
        "paths": []
      },
      "output": {
        "kind": "file",
        "persist": "file",
        "revertWrites": false
      },
      "schedule": {
        "backend": "none",
        "defaultCron": null,
        "schedulable": false
      },
      "scope": "project",
      "readOnly": false,
      "requiresRepo": false,
      "requiresLocalHost": true,
      "features": [
        "doc_gen"
      ],
      "availability": {
        "status": "retired",
        "reason": "Generate Documentation needs a template and sources; the Doc Gen screen and POST /generate-doc own it."
