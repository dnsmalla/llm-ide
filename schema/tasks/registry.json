{
  "version": 1,
  "tasks": [
    {
      "id": "loop.regression",
      "label": "Regression",
      "group": "Maintenance",
      "description": "Re-check every status:fixed fault report and reopen the ones that no longer verify.",
      "aliases": [
        "regression"
      ],
      "runner": {
        "kind": "shell",
        "stage": {
          "kind": "regressionSweep",
          "name": "Regression",
          "severity": "blocking",
          "allowsRepair": true
        },
        "timeoutSeconds": 1800
      },
      "input": {
        "kind": "project",
        "required": true,
        "paths": [
          "system/faults"
        ]
      },
      "output": {
        "kind": "fault-report",
        "persist": "run-record",
        "revertWrites": false
      },
      "schedule": {
        "backend": "desktop",
        "defaultCron": null,
        "schedulable": true
      },
      "scope": "project",
      "readOnly": false,
      "requiresRepo": true,
      "requiresLocalHost": true,
      "features": [],
      "availability": {
        "status": "available",
        "reason": null
      },
      "revision": 1
    },
    {
      "id": "sources.update",
      "label": "Source Update",
      "group": "Pipeline",
      "description": "Sync the connected server-side sources into the Library and record what changed.",
      "aliases": [
        "sourceUpdate"
      ],
      "runner": {
        "kind": "core-route",
        "route": "sources-update",
        "busKind": "sources.update",
        "timeoutSeconds": 1800
      },
      "input": {
        "kind": "project",
        "required": false,
        "paths": []
      },
      "output": {
        "kind": "text",
        "persist": "run-record",
        "revertWrites": false
      },
      "schedule": {
        "backend": "desktop",
        "defaultCron": null,
        "schedulable": true
      },
      "scope": "app",
      "readOnly": false,
      "requiresRepo": false,
      "requiresLocalHost": false,
      "features": [],
      "availability": {
        "status": "available",
        "reason": null
      },
      "revision": 1
    },
    {
      "id": "plan.status",
      "label": "Update Plan Status",
      "group": "Automation",
      "description": "Refresh the tracked outcomes and plan-task status from the connected trackers.",
      "aliases": [
        "updatePlanStatus"
      ],
      "runner": {
        "kind": "core-route",
        "route": "plan-status",
        "timeoutSeconds": 1800
      },
      "input": {
        "kind": "none",
        "required": false,
        "paths": []
      },
      "output": {
        "kind": "none",
        "persist": "run-record",
        "revertWrites": false
      },
      "schedule": {
        "backend": "desktop",
        "defaultCron": null,
        "schedulable": true
      },
      "scope": "app",
      "readOnly": false,
      "requiresRepo": false,
      "requiresLocalHost": false,
      "features": [],
      "availability": {
        "status": "available",
        "reason": null
      },
      "revision": 1
    }
  ]
}
