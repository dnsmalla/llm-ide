  "templates": [
    {
      "id": "test-and-fix",
      "name": "Test & Fix",
      "summary": "Re-check known faults, then the test suite, repairing until both are green.",
      "stages": [
        {
          "name": "Regression",
          "taskId": "loop.regression",
          "kind": "regressionSweep"
        },
        {
          "name": "Test",
          "command": "<detected-test-command>"
        }
      ]
    },
    {
      "id": "regression",
      "name": "Regression",
      "summary": "Re-check known faults only.",
      "config": {
        "maxIterations": 5
      },
      "stages": [
        {
          "name": "Regression",
          "taskId": "loop.regression",
          "kind": "regressionSweep"
        }
      ]
    },
    {
      "id": "test",
      "name": "Test",
      "summary": "Run just the test suite, repairing until green.",
      "stages": [
        {
          "name": "Test",
          "command": "<detected-test-command>"
        }
      ]
    },
    {
      "id": "full-verify",
      "name": "Full Verify",
      "summary": "Lint (advisory), tests, then the fault sweep.",
      "stages": [
        {
          "name": "Lint",
          "command": "make lint",
          "severity": "advisory"
        },
        {
          "name": "Test",
          "command": "<detected-test-command>"
        },
        {
          "name": "Regression",
          "taskId": "loop.regression",
          "kind": "regressionSweep"
        }
      ]
    },
    {
      "id": "skill-loop",
      "name": "Skill Loop",
      "summary": "Run a chosen skill as a generate step, gated by tests and the fault sweep.",
      "config": {
        "maxIterations": 6
      },
      "stages": [
        {
          "name": "Apply skill",
          "kind": "skill"
        },
        {
          "name": "Test",
          "command": "<detected-test-command>"
        },
        {
          "name": "Regression",
          "taskId": "loop.regression",
          "kind": "regressionSweep"
        }
      ]
    },
    {
      "id": "docs-refresh",
      "name": "Docs Refresh",
      "summary": "Regenerate documentation with a skill, then run the project docs check.",
      "config": {
        "maxIterations": 4,
        "maxRepairsPerStage": 2
      },
      "stages": [
        {
          "name": "Write docs",
          "kind": "skill"
        },
        {
          "name": "Docs check",
          "command": "make docs-check"
        }
      ]
    },
    {
      "id": "operation-diagnosis",
      "name": "Operation App Diagnosis",
      "summary": "Check the local server responds and the extension builds cleanly, then the fault sweep.",
      "config": {
        "maxIterations": 6
      },
      "stages": [
        {
          "name": "Server health",
          "command": "curl -sf http://127.0.0.1:3456/health"
        },
        {
          "name": "Extension build",
          "command": "cd extension && npm run build"
        },
        {
          "name": "Regression",
          "taskId": "loop.regression",
          "kind": "regressionSweep"
        }
      ]
    },
    {
      "id": "system-check",
      "name": "System Check",
      "summary": "Verify skills, plugins, connectors, dispatch, backend, shared protocol, the extension build and known faults.",
      "config": {
        "maxIterations": 8
      },
      "stages": [
        {
          "name": "Skills",
          "command": "cd extension && node --test tests/agent-skills.test.mjs tests/agent-skill-telemetry.test.mjs tests/skill-library.test.mjs tests/install-project-skills.test.mjs tests/task-skill-routing.test.mjs"
        },
        {
          "name": "Plugins",
          "command": "cd extension && node --test tests/plugins-loader.test.mjs tests/plugins-installer.test.mjs"
        },
        {
          "name": "Plugins + MCP",
          "command": "cd extension && node --test tests/mcp-config.test.mjs tests/mcp-state.test.mjs tests/mcp-plugin-servers.test.mjs tests/plugin-mcp-wiring.test.mjs tests/agent-v2-user-mcp.test.mjs tests/plugin-hook-trust.test.mjs tests/plugin-hook-runner.test.mjs tests/plugin-hook-trust-route.test.mjs tests/agent-v2-plugin-hooks.test.mjs tests/mcp-cli-args.test.mjs tests/route-mcp-mode.test.mjs"
        },
        {
          "name": "Connectors",
