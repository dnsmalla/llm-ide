#!/usr/bin/env bash
# Pre-push regression gate.
#
# Runs the relevant test suite before a push, scoped to what changed:
#   - schema/, scripts/, ui/, desktop/, web/, graph-kit, Makefile
#                               → `make regression` (contracts, desktop/ui/web
#                                 node suites, agent/v2 wire, graph-kit labs)
#   - extension/ or docs/reference/api/ only
#                               → `make contract-gates`
#   - extension/                → `make lint` and `make test`
#   - docs/ markdown            → markdownlint (as docs-ci)
#   - ios_app/                  → `make test-shared-protocol`
#   - the graph-kit gitlink     → the online pin check
# so a broken build or a regressed test never reaches the remote. A push
# that touches none of these skips the gate and returns immediately.
#
# Enable once per clone:  make hooks
# Bypass for one push:    git push --no-verify
set -uo pipefail

zero=0000000000000000000000000000000000000000
regression_changed=0
contract_changed=0
ext_changed=0
docs_changed=0
ios_changed=0
pin_changed=0

# stdin: <local_ref> <local_sha> <remote_ref> <remote_sha> per pushed ref.
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue   # branch deletion — nothing to test
    if [ "$remote_sha" = "$zero" ]; then
        # New branch on the remote: diff against origin/main when available,
        # otherwise be safe and run the gate.
        if git rev-parse --verify --quiet origin/main >/dev/null; then
            files=$(git diff --name-only "origin/main...$local_sha" 2>/dev/null || echo Makefile)
        else
            files="Makefile"
            pin_changed=1   # no origin/main to diff against: assume the pin moved
        fi
    else
        files=$(git diff --name-only "$remote_sha" "$local_sha" 2>/dev/null || echo Makefile)
    fi
    if printf '%s\n' "$files" | grep -qE '^(schema/|scripts/|ui/|desktop/|web/|graph-kit$|Makefile$)'; then
        regression_changed=1
    fi
    # The HTTP contract gate (~1 s): schemas, generators, the OpenAPI overlay and
    # server.mjs (SERVER_API_VERSION) feed it; `make regression` already runs it.
    if printf '%s\n' "$files" | grep -qE '^(extension/|docs/reference/api/)'; then
        contract_changed=1
    fi
    if printf '%s\n' "$files" | grep -qE '^docs/.*\.md$' && printf '%s\n' "$files" | grep -E '^docs/.*\.md$' | grep -qv '^docs/superpowers/'; then
        docs_changed=1
    fi
    # Pin trigger: the graph-kit gitlink moved (its path appears in the diff).
    if printf '%s\n' "$files" | grep -qx 'graph-kit'; then
        pin_changed=1
    fi
    if printf '%s\n' "$files" | grep -q '^extension/'; then
        ext_changed=1
    fi
    if printf '%s\n' "$files" | grep -q '^ios_app/'; then
        ios_changed=1
    fi
done

# The graph-kit pin (the submodule gitlink) must exist on the graph-kit remote,
# or every other machine fails to check it out. Online here (the offline form
# already runs inside `make regression`).
if [ "$pin_changed" -eq 1 ]; then
    echo "pre-push: graph-kit pin changed — checking it exists on the remote…"
    if ! node "$(git rev-parse --show-toplevel)/scripts/graphkit-pin-check.mjs" --online; then
        echo "pre-push: graph-kit pin check FAILED — push aborted." >&2
        echo "          Push graph-kit's commit first (git -C graph-kit push origin main)," >&2
        echo "          or fix the pin with make graphkit-bump. Bypass with: git push --no-verify" >&2
        exit 1
    fi
fi

if [ "$regression_changed" -eq 1 ]; then
    echo "pre-push: running regression gate (make regression)…"
    if ! make regression; then
        echo "pre-push: regression gate FAILED — push aborted." >&2
        echo "          Fix the failure, or bypass with: git push --no-verify" >&2
        exit 1
    fi
fi

# `make regression` already ran contract-gates.
if [ "$contract_changed" -eq 1 ] && [ "$regression_changed" -eq 0 ]; then
    echo "pre-push: HTTP contract changed — running contract gates (make contract-gates)…"
    if ! make contract-gates; then
        echo "pre-push: contract gate FAILED — push aborted." >&2
        echo "          Fix the failure, or bypass with: git push --no-verify" >&2
        exit 1
    fi
fi

# CI (extension-ci) fails on any ESLint warning or Prettier drift, and docs-ci on any
# markdownlint finding; the per-gate runs above never exercised either, so main went
# red twice on lint alone. Run the same commands CI runs.
if [ "$ext_changed" -eq 1 ]; then
    echo "pre-push: extension/ changed — running lint (make lint)…"
    if ! make lint; then
        echo "pre-push: extension lint FAILED — push aborted (CI would fail the same way)." >&2
        echo "          Fix with: make format   (then re-push), or bypass with: git push --no-verify" >&2
        exit 1
    fi
fi

if [ "$docs_changed" -eq 1 ]; then
    echo "pre-push: docs/ changed — running markdown lint (same command as docs-ci)…"
    if command -v markdownlint-cli2 >/dev/null 2>&1; then
        mdlint=(markdownlint-cli2)
    else
        mdlint=(npx --yes markdownlint-cli2)
    fi
    if ! "${mdlint[@]}" "docs/**/*.md" "!docs/superpowers/**"; then
        echo "pre-push: markdown lint FAILED — push aborted (docs-ci would fail the same way)." >&2
        echo "          Auto-fix most findings: npx markdownlint-cli2 --fix 'docs/**/*.md' '!docs/superpowers/**'" >&2
        echo "          or bypass with: git push --no-verify" >&2
        exit 1
    fi
fi

if [ "$ext_changed" -eq 1 ]; then
    echo "pre-push: extension/ changed — running backend tests (make test)…"
    if ! make test; then
        echo "pre-push: backend test gate FAILED — push aborted." >&2
        echo "          Fix the failure, or bypass with: git push --no-verify" >&2
        exit 1
    fi
fi

if [ "$ios_changed" -eq 1 ]; then
    echo "pre-push: ios_app/ changed — running SharedProtocol gate (make test-shared-protocol)…"
    if ! make test-shared-protocol; then
        echo "pre-push: SharedProtocol gate FAILED — push aborted." >&2
        echo "          Fix the failure, or bypass with: git push --no-verify" >&2
        exit 1
    fi
fi

exit 0
